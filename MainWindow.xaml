<Window x:Class="HikDeployTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HikDeployTool"
        mc:Ignorable="d"
        Title="{x:Static local:CompanyInfo.WindowTitle}"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="880" Width="1400"
        MinHeight="700" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushAppBackground}"
        FontFamily="{StaticResource FontUi}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== 顶部标题条 ==================== -->
        <Border Grid.Row="0" Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushDivider}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0" Height="62">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="9"
                        Background="{StaticResource BrushBrandSoft}" VerticalAlignment="Center">
                    <!-- 品牌标识：与任务栏/关于页共用的"镜头 + 信号"（IconBrandMark），
                         比通用图标略大一号，标题条上它是这个软件的脸面。 -->
                    <Path Data="{StaticResource IconBrandMark}" Style="{StaticResource IconPath}"
                          Width="20" Height="20"
                          Stroke="{StaticResource BrushBrand}" StrokeThickness="1.6"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding AppTitle}" FontSize="15.5" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <!-- 交付单位紧跟软件名，而不是塞进下面的副标题：
                             交接时甲方第一句问的就是"哪家单位做的"，放进副标题会被
                             当成功能描述一眼扫过去。竖线只做视觉分隔，不参与命中测试。 -->
                        <Border Width="1" Height="13" Margin="10,0" VerticalAlignment="Center"
                                Background="{StaticResource BrushBorderStrong}" IsHitTestVisible="False" />
                        <TextBlock Text="{Binding CompanyName}" FontSize="13" VerticalAlignment="Center"
                                   Foreground="{StaticResource BrushTextSecondary}" />
                    </StackPanel>
                    <TextBlock Text="{Binding AppSubtitle}" FontSize="11.5"
                               Foreground="{StaticResource BrushTextMuted}" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 自检有问题时常驻提醒，点一下直接跳到设置页（按类型解析，页面顺序怎么排都不会指错） -->
                    <Button Style="{StaticResource SoftButton}" Margin="0,0,10,0"
                            Command="{Binding NavigateCommand}" CommandParameter="{Binding SettingsPage}"
                            Visibility="{Binding HasEnvIssue, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="有必需依赖缺失或权限不足，点击查看详情">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPathSm}" Data="{StaticResource IconWarn}"
                                  Stroke="{StaticResource BrushWarning}" Margin="0,0,6,0" />
                            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource BrushWarning}">
                                <Run Text="环境自检 " />
                                <Run Text="{Binding EnvIssueCount, Mode=OneWay}" />
                                <Run Text=" 项待处理" />
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <Border Style="{StaticResource Chip}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource BrushSuccess}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAdministrator}" Value="False">
                                                <Setter Property="Fill" Value="{StaticResource BrushWarning}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Style="{StaticResource ChipText}" Text="{Binding PrivilegeText}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Chip}">
                        <TextBlock Style="{StaticResource ChipText}" Text="{Binding SadpVersionText}" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 主体：左导航 + 右内容 ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource BrushNavBackground}"
                    BorderBrush="{StaticResource BrushDivider}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="功能导航" Margin="20,18,0,8"
                               FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextMuted}" />

                    <TextBlock DockPanel.Dock="Bottom" Margin="20,10,16,16"
                               Style="{StaticResource TextHint}" FontSize="11"
                               Text="提示：所有批量操作都默认并发 4 台，可在「设置与自检」里调整。设备改 IP 后会重启，稍等 30 秒再搜索。" />

                    <ListBox x:Name="NavList" ItemsSource="{Binding Pages}"
                             SelectedItem="{Binding CurrentPage, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Margin="10,0,10,0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,3" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" CornerRadius="8" Background="Transparent"
                                                    Padding="11,9" SnapsToDevicePixels="True">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushNeutralSoft}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushAccentSoft}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Path Grid.Column="0" VerticalAlignment="Top" Margin="0,1,10,0"
                                          Data="{Binding Glyph, Converter={StaticResource ResourceKeyToGeometry}}">
                                        <Path.Style>
                                            <Style TargetType="Path" BasedOn="{StaticResource IconPath}">
                                                <Style.Triggers>
                                                    <DataTrigger Value="True"
                                                                 Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                                        <Setter Property="Stroke" Value="{StaticResource BrushAccent}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" ToolTip="{Binding Description}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontSize" Value="13" />
                                                    <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True"
                                                                     Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                                            <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                                   FontSize="11" LineHeight="15" Margin="0,3,0,0"
                                                   Foreground="{StaticResource BrushTextMuted}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <DockPanel Grid.Column="1">
                <!-- 页面标题区 -->
                <Border DockPanel.Dock="Top" Padding="22,16,22,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding CurrentPage.Title}" Style="{StaticResource TextPageTitle}" />
                            <TextBlock Text="{Binding CurrentPage.Usage}" Style="{StaticResource TextHint}"
                                       Margin="0,5,0,0" MaxWidth="820" HorizontalAlignment="Left" />
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource Chip}" VerticalAlignment="Top"
                                Visibility="{Binding IsSadpRunning, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                            <TextBlock Style="{StaticResource ChipWarningText}" Text="搜索未启动" />
                        </Border>
                    </Grid>
                </Border>

                <ContentControl Content="{Binding CurrentPage}" Margin="22,0,22,18"
                                VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch" />
            </DockPanel>
        </Grid>

        <!-- ==================== 状态栏 ==================== -->
        <Border Grid.Row="2" Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushDivider}" BorderThickness="0,1,0,0">
            <Grid Margin="20,0" Height="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Style="{StaticResource IconPathSm}" Data="{StaticResource IconList}"
                          Stroke="{StaticResource BrushTextMuted}" Margin="0,0,7,0" />
                    <TextBlock Text="{Binding CountSummary}" FontSize="12"
                               Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="18,0" FontSize="12"
                           Foreground="{StaticResource BrushTextMuted}" TextTrimming="CharacterEllipsis"
                           Text="{Binding CurrentPage.Description}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 版权：常驻在状态栏最右侧。放在这里而不是只放"关于"页里，
                         是因为导出的截图、录屏往往只剩这一条状态栏可见。 -->
                    <TextBlock Text="{Binding Copyright}" FontSize="11.5" VerticalAlignment="Center"
                               Foreground="{StaticResource BrushTextMuted}" />
                    <Border Width="1" Height="12" Margin="10,0" VerticalAlignment="Center"
                            Background="{StaticResource BrushBorder}" />
                    <Path Style="{StaticResource IconPathSm}" Data="{StaticResource IconClock}"
                          Stroke="{StaticResource BrushTextMuted}" Margin="0,0,7,0" />
                    <TextBlock Text="{Binding Clock}" FontSize="12" FontFamily="{StaticResource FontMono}"
                               Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 忙碌遮罩 ==================== -->
        <Grid Grid.RowSpan="3" Background="{StaticResource BrushOverlay}" Panel.ZIndex="10"
              Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <Border Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1" CornerRadius="10" Padding="30,24"
                    Effect="{StaticResource ShadowCard}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="320">
                <StackPanel>
                    <!-- 自己画一条跑马灯：自定义 ProgressBar 模板里没有 IsIndeterminate 的动画，
                         直接用系统的不确定态会显示成一条空槽，看着像卡住了。 -->
                    <Border Width="260" Height="6" CornerRadius="3"
                            Background="{StaticResource BrushSurfaceSunken}" ClipToBounds="True">
                        <Border Width="90" Height="6" CornerRadius="3" HorizontalAlignment="Left"
                                Background="{StaticResource BrushAccent}">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="BusyTranslate" X="-90" />
                            </Border.RenderTransform>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Border.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="BusyTranslate"
                                                             Storyboard.TargetProperty="X"
                                                             From="-90" To="260" Duration="0:0:1.3" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                        </Border>
                    </Border>
                    <TextBlock Text="{Binding BusyText}" Margin="0,16,0,0" TextAlignment="Center"
                               FontSize="13" Foreground="{StaticResource BrushTextSecondary}"
                               TextWrapping="Wrap" MaxWidth="300" />
                    <TextBlock Text="请勿关闭窗口，设备响应可能需要一点时间" Margin="0,8,0,0"
                               TextAlignment="Center" FontSize="11.5"
                               Foreground="{StaticResource BrushTextMuted}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== Toast 提示 ==================== -->
        <Border Grid.RowSpan="3" Panel.ZIndex="20"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,74,22,0" MaxWidth="420"
                Visibility="{Binding ToastVisible, Converter={StaticResource BoolToVisibility}}"
                CornerRadius="8" Padding="14,11"
                Effect="{StaticResource ShadowToast}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource BrushTextPrimary}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ToastIsError}" Value="True">
                            <Setter Property="Background" Value="{StaticResource BrushDanger}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Path Grid.Column="0" Style="{StaticResource IconPathSm}" Data="{StaticResource IconInfo}"
                      Stroke="{StaticResource BrushTextOnAccent}" Margin="0,2,10,0" VerticalAlignment="Top" />

                <TextBlock Grid.Column="1" Text="{Binding ToastMessage}" TextWrapping="Wrap"
                           Foreground="{StaticResource BrushTextOnAccent}" FontSize="12.5" LineHeight="19" />

                <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="22" Height="22"
                        Margin="10,0,0,0" VerticalAlignment="Top" Click="DismissToast_Click"
                        ToolTip="关闭">
                    <Path Data="M 0,0 L 9,9 M 9,0 L 0,9" Stroke="{StaticResource BrushTextOnAccent}"
                          StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="9" Height="9" Stretch="None" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
