<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      配色（浅色主题）。
      取值原则：大面积留白 + 低饱和灰蓝做底，只让"需要用户注意的东西"有颜色。
      现场用投影仪或者在机房里看屏幕时，低饱和底色比高饱和更耐看、也更不刺眼。
      涨跌色规则在此工具中不涉及；状态色遵循国内习惯：绿=正常、橙=警告、红=错误。
    -->

    <!-- ============ 底层与面板 ============ -->
    <SolidColorBrush x:Key="BrushAppBackground" Color="#EEF1F6" />
    <SolidColorBrush x:Key="BrushSurface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BrushSurfaceAlt" Color="#F7F9FC" />
    <SolidColorBrush x:Key="BrushSurfaceSunken" Color="#EFF3F8" />
    <SolidColorBrush x:Key="BrushNavBackground" Color="#FBFCFE" />
    <SolidColorBrush x:Key="BrushOverlay" Color="#B3FFFFFF" />

    <!-- ============ 描边 ============ -->
    <SolidColorBrush x:Key="BrushBorder" Color="#DDE3EC" />
    <SolidColorBrush x:Key="BrushBorderStrong" Color="#C3CCDA" />
    <SolidColorBrush x:Key="BrushDivider" Color="#EAEFF6" />

    <!-- ============ 文字 ============ -->
    <SolidColorBrush x:Key="BrushTextPrimary" Color="#1B2430" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="#5A6879" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="#8D9AAA" />
    <SolidColorBrush x:Key="BrushTextOnAccent" Color="#FFFFFF" />

    <!-- ============ 主题色 ============ -->
    <SolidColorBrush x:Key="BrushAccent" Color="#1F6FEB" />
    <SolidColorBrush x:Key="BrushAccentHover" Color="#1A5FCC" />
    <SolidColorBrush x:Key="BrushAccentPressed" Color="#164FA8" />
    <SolidColorBrush x:Key="BrushAccentSoft" Color="#E8F0FE" />
    <SolidColorBrush x:Key="BrushAccentSoftHover" Color="#D8E6FD" />
    <SolidColorBrush x:Key="BrushBrand" Color="#C8102E" />
    <SolidColorBrush x:Key="BrushBrandSoft" Color="#FDEAEC" />

    <!-- ============ 状态色 ============ -->
    <SolidColorBrush x:Key="BrushSuccess" Color="#0F8A43" />
    <SolidColorBrush x:Key="BrushSuccessSoft" Color="#E6F6EC" />
    <SolidColorBrush x:Key="BrushWarning" Color="#B26A00" />
    <SolidColorBrush x:Key="BrushWarningSoft" Color="#FFF3DF" />
    <SolidColorBrush x:Key="BrushDanger" Color="#C62828" />
    <SolidColorBrush x:Key="BrushDangerHover" Color="#AD2020" />
    <SolidColorBrush x:Key="BrushDangerSoft" Color="#FCE9E9" />
    <SolidColorBrush x:Key="BrushNeutralSoft" Color="#ECEFF4" />

    <!-- ============ 日志等级 ============ -->
    <SolidColorBrush x:Key="BrushLogDebug" Color="#8D9AAA" />
    <SolidColorBrush x:Key="BrushLogInfo" Color="#1F6FEB" />
    <SolidColorBrush x:Key="BrushLogSuccess" Color="#0F8A43" />
    <SolidColorBrush x:Key="BrushLogWarn" Color="#B26A00" />
    <SolidColorBrush x:Key="BrushLogError" Color="#C62828" />

    <!-- ============ 字体 ============ -->
    <FontFamily x:Key="FontUi">Microsoft YaHei UI, Microsoft YaHei, Segoe UI, SimSun</FontFamily>
    <FontFamily x:Key="FontMono">Consolas, Cascadia Mono, Courier New, Microsoft YaHei UI</FontFamily>

    <!-- ============ 阴影 ============ -->
    <DropShadowEffect x:Key="ShadowCard" BlurRadius="14" ShadowDepth="1" Direction="270"
                      Color="#2A3A52" Opacity="0.10" RenderingBias="Quality" />

    <DropShadowEffect x:Key="ShadowToast" BlurRadius="20" ShadowDepth="3" Direction="270"
                      Color="#1B2430" Opacity="0.20" RenderingBias="Quality" />

</ResourceDictionary>
