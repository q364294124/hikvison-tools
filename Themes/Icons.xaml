<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      图标集合。
      全部用 GeometryGroup + 基础几何（椭圆/矩形/折线）拼出来，坐标统一按 24x24 设计。
      这样做的好处：不依赖任何图标字体或外部文件（现场机器可能没网、没装字体），
      也不会因为 SVG 路径字符串写错而导致整个 XAML 解析失败。
      使用方式：<Path Style="{StaticResource IconPath}" Data="{StaticResource IconSearch}" />
    -->

    <!-- ============ 左侧导航 ============ -->

    <!-- 设备发现：放大镜 -->
    <GeometryGroup x:Key="IconSearch">
        <EllipseGeometry Center="10.5,10.5" RadiusX="6.5" RadiusY="6.5" />
        <LineGeometry StartPoint="15.3,15.3" EndPoint="20.8,20.8" />
    </GeometryGroup>

    <!-- 批量激活：闪电 -->
    <GeometryGroup x:Key="IconBolt">
        <PathGeometry Figures="M 13.4,2.2 L 5.2,13.2 L 11.2,13.2 L 10.2,21.8 L 18.8,10.6 L 12.6,10.6 Z" />
    </GeometryGroup>

    <!-- 网络配置：节点拓扑 -->
    <GeometryGroup x:Key="IconNetwork">
        <EllipseGeometry Center="12,4.8" RadiusX="2.8" RadiusY="2.8" />
        <EllipseGeometry Center="5,18.5" RadiusX="2.8" RadiusY="2.8" />
        <EllipseGeometry Center="19,18.5" RadiusX="2.8" RadiusY="2.8" />
        <LineGeometry StartPoint="12,7.6" EndPoint="12,12" />
        <LineGeometry StartPoint="6.8,16" EndPoint="10.8,13.2" />
        <LineGeometry StartPoint="17.2,16" EndPoint="13.2,13.2" />
    </GeometryGroup>

    <!-- 密码重置：钥匙 -->
    <GeometryGroup x:Key="IconKey">
        <EllipseGeometry Center="7.4,12" RadiusX="4.2" RadiusY="4.2" />
        <LineGeometry StartPoint="11.6,12" EndPoint="21.2,12" />
        <LineGeometry StartPoint="18,12" EndPoint="18,15" />
        <LineGeometry StartPoint="21,12" EndPoint="21,15" />
    </GeometryGroup>

    <!-- 资产台账：清单 -->
    <GeometryGroup x:Key="IconList">
        <RectangleGeometry Rect="3,5,3.2,3.2" />
        <RectangleGeometry Rect="3,10.4,3.2,3.2" />
        <RectangleGeometry Rect="3,15.8,3.2,3.2" />
        <LineGeometry StartPoint="9,6.6" EndPoint="21,6.6" />
        <LineGeometry StartPoint="9,12" EndPoint="21,12" />
        <LineGeometry StartPoint="9,17.4" EndPoint="21,17.4" />
    </GeometryGroup>

    <!-- 项目验收：勾选 -->
    <GeometryGroup x:Key="IconCheck">
        <PathGeometry Figures="M 3.2,12.6 L 5.6,10.2 L 9.6,14.2 L 18.8,5" />
        <PathGeometry Figures="M 3.2,19.4 L 5.6,17 L 9.6,21 L 18.8,11.8" />
    </GeometryGroup>

    <!-- 运行日志：终端 -->
    <GeometryGroup x:Key="IconTerminal">
        <RectangleGeometry Rect="2.5,4,19,16" RadiusX="2" RadiusY="2" />
        <PathGeometry Figures="M 6.5,9.5 L 10,12.5 L 6.5,15.5" />
        <LineGeometry StartPoint="12,16" EndPoint="17.5,16" />
    </GeometryGroup>

    <!-- 设置与自检：调节滑杆 -->
    <GeometryGroup x:Key="IconSettings">
        <LineGeometry StartPoint="3,7" EndPoint="21,7" />
        <EllipseGeometry Center="9,7" RadiusX="2.1" RadiusY="2.1" />
        <LineGeometry StartPoint="3,12" EndPoint="21,12" />
        <EllipseGeometry Center="15.5,12" RadiusX="2.1" RadiusY="2.1" />
        <LineGeometry StartPoint="3,17" EndPoint="21,17" />
        <EllipseGeometry Center="7.5,17" RadiusX="2.1" RadiusY="2.1" />
    </GeometryGroup>

    <!-- ============ 按钮与标识 ============ -->

    <GeometryGroup x:Key="IconRefresh">
        <PathGeometry Figures="M 20,12 A 8,8 0 1 1 16.6,5.7" />
        <PathGeometry Figures="M 17.6,1.4 L 17.6,6.4 L 22.6,6.4" />
    </GeometryGroup>

    <GeometryGroup x:Key="IconTrash">
        <PathGeometry Figures="M 4.5,6.8 H 19.5" />
        <PathGeometry Figures="M 9.2,6.8 V 4.2 H 14.8 V 6.8" />
        <PathGeometry Figures="M 6.6,6.8 L 7.8,20.4 H 16.2 L 17.4,6.8" />
        <PathGeometry Figures="M 10.2,10.4 V 17.2 M 13.8,10.4 V 17.2" />
    </GeometryGroup>

    <GeometryGroup x:Key="IconExport">
        <PathGeometry Figures="M 12,3 V 15" />
        <PathGeometry Figures="M 7.6,10.8 L 12,15.2 L 16.4,10.8" />
        <PathGeometry Figures="M 4,16.6 V 20 H 20 V 16.6" />
    </GeometryGroup>

    <GeometryGroup x:Key="IconImport">
        <PathGeometry Figures="M 12,15.2 V 3.2" />
        <PathGeometry Figures="M 7.6,7.6 L 12,3.2 L 16.4,7.6" />
        <PathGeometry Figures="M 4,16.6 V 20 H 20 V 16.6" />
    </GeometryGroup>

    <GeometryGroup x:Key="IconPlay">
        <PathGeometry Figures="M 7.5,4.6 L 19.2,12 L 7.5,19.4 Z" />
    </GeometryGroup>

    <GeometryGroup x:Key="IconStop">
        <RectangleGeometry Rect="6,6,12,12" RadiusX="1.5" RadiusY="1.5" />
    </GeometryGroup>

    <GeometryGroup x:Key="IconFolder">
        <PathGeometry Figures="M 3,6.6 A 1.8,1.8 0 0 1 4.8,4.8 H 9.4 L 11.4,7.4 H 19.2 A 1.8,1.8 0 0 1 21,9.2 V 17.4 A 1.8,1.8 0 0 1 19.2,19.2 H 4.8 A 1.8,1.8 0 0 1 3,17.4 Z" />
    </GeometryGroup>

    <GeometryGroup x:Key="IconCopy">
        <RectangleGeometry Rect="8.6,8.6,11.4,11.4" RadiusX="1.6" RadiusY="1.6" />
        <PathGeometry Figures="M 5.4,15.4 V 5.6 A 1.4,1.4 0 0 1 6.8,4.2 H 16.6" />
    </GeometryGroup>

    <GeometryGroup x:Key="IconShield">
        <PathGeometry Figures="M 12,2.8 L 20,5.8 V 12 C 20,16.8 16.4,19.8 12,21.4 C 7.6,19.8 4,16.8 4,12 V 5.8 Z" />
        <PathGeometry Figures="M 8.8,11.8 L 11.2,14.2 L 15.4,9.6" />
    </GeometryGroup>

    <GeometryGroup x:Key="IconInfo">
        <EllipseGeometry Center="12,12" RadiusX="9.2" RadiusY="9.2" />
        <PathGeometry Figures="M 12,10.8 V 17" />
        <PathGeometry Figures="M 12,7.2 V 7.9" />
    </GeometryGroup>

    <GeometryGroup x:Key="IconWarn">
        <PathGeometry Figures="M 12,2.8 L 22.2,20.4 H 1.8 Z" />
        <PathGeometry Figures="M 12,9 V 14.4" />
        <PathGeometry Figures="M 12,16.8 V 17.6" />
    </GeometryGroup>

    <GeometryGroup x:Key="IconAdd">
        <PathGeometry Figures="M 12,4.6 V 19.4 M 4.6,12 H 19.4" />
    </GeometryGroup>

    <GeometryGroup x:Key="IconEdit">
        <PathGeometry Figures="M 4.2,19.8 L 5,16 L 16.6,4.4 A 1.7,1.7 0 0 1 19,4.4 L 19.6,5 A 1.7,1.7 0 0 1 19.6,7.4 L 8,19 L 4.2,19.8 Z" />
        <PathGeometry Figures="M 15.2,5.8 L 18.2,8.8" />
    </GeometryGroup>

    <GeometryGroup x:Key="IconSave">
        <PathGeometry Figures="M 5,3.2 H 14.6 L 20.8,9.4 V 19 A 1.6,1.6 0 0 1 19.2,20.6 H 5 A 1.6,1.6 0 0 1 3.4,19 V 4.8 A 1.6,1.6 0 0 1 5,3.2 Z" />
        <PathGeometry Figures="M 7.6,3.2 V 9.4 H 15.6 V 3.2" />
        <PathGeometry Figures="M 7.6,20.6 V 14.2 H 16.4 V 20.6" />
    </GeometryGroup>

    <GeometryGroup x:Key="IconReport">
        <RectangleGeometry Rect="4.6,2.8,14.8,18.4" RadiusX="1.6" RadiusY="1.6" />
        <PathGeometry Figures="M 8,8 H 16 M 8,12 H 16 M 8,16 H 13" />
    </GeometryGroup>

    <GeometryGroup x:Key="IconSnapshot">
        <PathGeometry Figures="M 3.6,8.4 H 7.8 L 9.6,5.4 H 14.4 L 16.2,8.4 H 20.4 V 19 H 3.6 Z" />
        <EllipseGeometry Center="12,13.2" RadiusX="3.4" RadiusY="3.4" />
    </GeometryGroup>

    <GeometryGroup x:Key="IconEye">
        <PathGeometry Figures="M 2.2,12 C 5.2,7.4 8.4,5.2 12,5.2 C 15.6,5.2 18.8,7.4 21.8,12 C 18.8,16.6 15.6,18.8 12,18.8 C 8.4,18.8 5.2,16.6 2.2,12 Z" />
        <EllipseGeometry Center="12,12" RadiusX="2.9" RadiusY="2.9" />
    </GeometryGroup>

    <GeometryGroup x:Key="IconEyeOff">
        <PathGeometry Figures="M 2.2,12 C 5.2,7.4 8.4,5.2 12,5.2 C 15.6,5.2 18.8,7.4 21.8,12 C 18.8,16.6 15.6,18.8 12,18.8 C 8.4,18.8 5.2,16.6 2.2,12 Z" />
        <EllipseGeometry Center="12,12" RadiusX="2.9" RadiusY="2.9" />
        <PathGeometry Figures="M 4,4 L 20,20" />
    </GeometryGroup>

    <GeometryGroup x:Key="IconArrowRight">
        <PathGeometry Figures="M 4.6,12 H 18.2" />
        <PathGeometry Figures="M 13.2,7 L 18.4,12 L 13.2,17" />
    </GeometryGroup>

    <GeometryGroup x:Key="IconTag">
        <PathGeometry Figures="M 11.2,3.4 H 19 A 1.6,1.6 0 0 1 20.6,5 V 12.8 L 12,21.4 L 3.4,12.8 Z" />
        <EllipseGeometry Center="16.4,7.6" RadiusX="1.6" RadiusY="1.6" />
    </GeometryGroup>

    <GeometryGroup x:Key="IconClock">
        <EllipseGeometry Center="12,12" RadiusX="9" RadiusY="9" />
        <PathGeometry Figures="M 12,6.6 V 12.4 L 16.4,15" />
    </GeometryGroup>

    <!-- 品牌标识：几何化的镜头轮廓 -->
    <GeometryGroup x:Key="IconBrand">
        <PathGeometry Figures="M 12,2.6 L 20.4,7.4 V 16.6 L 12,21.4 L 3.6,16.6 V 7.4 Z" />
        <EllipseGeometry Center="12,12" RadiusX="4.2" RadiusY="4.2" />
    </GeometryGroup>

    <!--
      品牌标识（新版）：镜头 + 信号。
      镜头圆环 + 镜芯点题"安防监控设备"，右上两道发散的信号弧表示
      设备在线 / 数据回传，对应本工具"搜索 → 配置 → 验收"这条主线。
      exe 的程序图标（Assets/app.ico，由 tools/make_app_icon.py 生成）
      用的是同一套几何的实心填充版 —— 这里改坐标，那边要同步改。
    -->
    <GeometryGroup x:Key="IconBrandMark">
        <EllipseGeometry Center="10,14" RadiusX="4.25" RadiusY="4.25" />
        <EllipseGeometry Center="10,14" RadiusX="1.6" RadiusY="1.6" />
        <PathGeometry Figures="M 12.35,6.77 A 7.6,7.6 0 0 1 17.23,11.65" />
        <PathGeometry Figures="M 14.07,4.87 A 10,10 0 0 1 19.14,9.93" />
    </GeometryGroup>

    <!-- 门禁：门板 + 门把手。门禁页导航/标题用它。 -->
    <GeometryGroup x:Key="IconDoor">
        <PathGeometry Figures="M 7,3 H 17 V 21 H 7 Z" />
        <EllipseGeometry Center="14.9,12.5" RadiusX="0.95" RadiusY="0.95" />
    </GeometryGroup>

    <!-- 关闭：右上到左下、左上到右下两条对角线。用于关掉一路预览画面。 -->
    <GeometryGroup x:Key="IconClose">
        <PathGeometry Figures="M 6,6 L 18,18" />
        <PathGeometry Figures="M 18,6 L 6,18" />
    </GeometryGroup>

    <!-- 云台方向箭头（向上基准，配合 RotateTransform 摆出八个方向）。 -->
    <GeometryGroup x:Key="IconArrow">
        <PathGeometry Figures="M 12,5 L 12,19" />
        <PathGeometry Figures="M 12,5 L 6.5,10.5" />
        <PathGeometry Figures="M 12,5 L 17.5,10.5" />
    </GeometryGroup>

    <!-- 单画面：一个矩形画面框（1 分屏）。 -->
    <GeometryGroup x:Key="IconLayout1">
        <PathGeometry Figures="M 3.5,5.5 H 20.5 V 18.5 H 3.5 Z" />
    </GeometryGroup>

    <!-- 四画面：田字四格（4 分屏）。 -->
    <GeometryGroup x:Key="IconLayout4">
        <PathGeometry Figures="M 11.5,3.5 V 20.5" />
        <PathGeometry Figures="M 3.5,12 H 20.5" />
        <PathGeometry Figures="M 3.5,3.5 H 20.5 V 20.5 H 3.5 Z" />
    </GeometryGroup>

    <!-- 九画面：井字九格（9 分屏）。 -->
    <GeometryGroup x:Key="IconLayout9">
        <PathGeometry Figures="M 9.2,3.5 V 20.5" />
        <PathGeometry Figures="M 14.8,3.5 V 20.5" />
        <PathGeometry Figures="M 3.5,9.2 H 20.5" />
        <PathGeometry Figures="M 3.5,14.8 H 20.5" />
        <PathGeometry Figures="M 3.5,3.5 H 20.5 V 20.5 H 3.5 Z" />
    </GeometryGroup>

    <!-- 摄像机：机身 + 镜头 + 底座，用于设备树里的通道节点。 -->
    <GeometryGroup x:Key="IconCamera">
        <PathGeometry Figures="M 3.5,7.5 H 15.5 V 16.5 H 3.5 Z" />
        <PathGeometry Figures="M 15.5,10 L 20.5,7.5 V 16.5 L 15.5,14 Z" />
        <PathGeometry Figures="M 9.5,16.5 V 19.5" />
        <PathGeometry Figures="M 6.5,19.5 H 12.5" />
    </GeometryGroup>

</ResourceDictionary>
