<Application x:Class="HikDeployTool.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HikDeployTool"
             xmlns:views="clr-namespace:HikDeployTool.Views"
             xmlns:vm="clr-namespace:HikDeployTool.ViewModels">
    <Application.Resources>
        <ResourceDictionary>
            <!-- 顺序有讲究：先颜色（其它两个都引用它），再图标，最后控件模板。 -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml" />
                <ResourceDictionary Source="Themes/Icons.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 转换器集中注册，页面 XAML 里统一用 StaticResource 引用。 -->
            <views:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <views:InverseBooleanConverter x:Key="InverseBoolean" />
            <views:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibility" />
            <views:EmptyToVisibilityConverter x:Key="EmptyToVisibility" />
            <views:CountToVisibilityConverter x:Key="CountToVisibility" />
            <views:ReferenceEqualsToBoolConverter x:Key="ReferenceEqualsToBool" />
            <views:ResourceKeyToGeometryConverter x:Key="ResourceKeyToGeometry" />
            <views:LogLevelToBrushConverter x:Key="LogLevelToBrush" />
            <views:LogLevelToTagConverter x:Key="LogLevelToTag" />

            <!--
              页面 ViewModel → View 的映射。
              主窗口只放一个 ContentControl 绑 CurrentPage，靠这些模板决定渲染哪个视图；
              这样导航栏不必知道任何视图类型，加页面时只在这里加一行。
            -->
            <DataTemplate DataType="{x:Type vm:DeviceDiscoveryViewModel}">
                <views:DeviceDiscoveryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ActivationViewModel}">
                <views:ActivationView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:NetworkConfigViewModel}">
                <views:NetworkConfigView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PasswordResetViewModel}">
                <views:PasswordResetView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AssetViewModel}">
                <views:AssetView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AcceptanceViewModel}">
                <views:AcceptanceView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PreviewViewModel}">
                <views:PreviewView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DoorControlViewModel}">
                <views:DoorControlView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LogViewModel}">
                <views:LogView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AboutViewModel}">
                <views:AboutView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
