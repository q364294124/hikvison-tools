<UserControl x:Class="HikDeployTool.Views.PasswordResetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:HikDeployTool.Views">

    <!--
      布局说明（别随手改回去）：
      本页内容比一屏高。执行条必须永远可见，所以用 DockPanel 把它钉在底部；
      其余内容整体放进 ScrollViewer，清单区用 MinHeight 而不是 * 高度
      —— 在 ScrollViewer 里 * 行会被撑成无限高，清单就永远显示不出来了。
      二维码卡片放在第 0 行的中间列，保证进页面第一眼就能看到码，
      不会被挤到折叠线以下（这正是"二维码显示不出来"最容易复发的形式）。
    -->
    <DockPanel LastChildFill="True">

        <!-- ==================== 执行条（钉底） ==================== -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" />
                    <TextBlock Style="{StaticResource TextHint}" Margin="0,7,0,0">
                        <Run Text="{Binding ProgressText, Mode=OneWay}" />
                        <Run Text="  ·  " />
                        <Run Text="{Binding ResultSummary, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}"
                            Content="取消" Margin="0,0,8,0"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                    <Button Command="{Binding ExportResultsCommand}" Style="{StaticResource SecondaryButton}"
                            Content="导出结果" Margin="0,0,8,0" />
                    <Button Command="{Binding RunCommand}" Style="{StaticResource PrimaryButton}"
                            MinWidth="128" Content="{Binding RunButtonText}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 其余内容（可滚动） ==================== -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,8,0" Focusable="False">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ==================== ① 重置方式 / ② 二维码 / ③ 新口令 ==================== -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.06*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="0.94*" />
                    </Grid.ColumnDefinitions>

                    <!-- ① 重置方式 + 对应凭据 -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="① 选择重置方式" Style="{StaticResource TextSection}" />

                            <ComboBox Margin="0,10,0,0" ItemsSource="{Binding ResetTypes}"
                                      DisplayMemberPath="Label"
                                      SelectedValue="{Binding ResetType}" SelectedValuePath="Value"
                                      HorizontalAlignment="Left" MinWidth="190" />
                            <TextBlock Style="{StaticResource TextHint}" Margin="0,7,0,0" TextWrapping="Wrap"
                                       Text="{Binding CurrentTypeHint}" />

                            <Border Style="{StaticResource Divider}" Margin="0,12,0,12" />

                            <!-- 方式 3 / 6 / 7：都要把扫码换回来的口令填在这里 -->
                            <StackPanel Visibility="{Binding NeedResetToken, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding CodeLabel}" Style="{StaticResource TextLabel}" />
                                <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{StaticResource FontMono}" />
                                <TextBlock Style="{StaticResource TextHint}" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="{Binding CodeHint}" />
                            </StackPanel>

                            <!-- 方式 2：授权文件 -->
                            <StackPanel Visibility="{Binding NeedAuthFile, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="GUID 加密文件" Style="{StaticResource TextLabel}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding AuthFile, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1" Command="{Binding PickAuthFileCommand}"
                                            Style="{StaticResource SecondaryButton}" Content="选择文件" Margin="8,0,0,0" />
                                </Grid>
                                <TextBlock Style="{StaticResource TextHint}" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="设备在网页端导出的加密文件，离线解密后得到新口令。适合完全没有网络的现场。" />
                            </StackPanel>

                            <!-- 方式 4：GUID 字符串 -->
                            <StackPanel Visibility="{Binding NeedGuid, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="GUID 字符串" Style="{StaticResource TextLabel}" />
                                <TextBox Text="{Binding Guid, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{StaticResource FontMono}" />
                                <TextBlock Style="{StaticResource TextHint}" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="32 位十六进制字符串，可展开下方「批量读取设备码 / GUID」一并取出。" />
                            </StackPanel>

                            <!-- 方式 5：安全问题 -->
                            <StackPanel Visibility="{Binding NeedAnswers, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <TextBlock Text="安全问题答案" Style="{StaticResource TextLabel}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,5">
                                        <Button Command="{Binding AddAnswerCommand}" Style="{StaticResource GhostButton}"
                                                Content="+ 加一项" MinHeight="24" Padding="6,0" />
                                        <Button Command="{Binding RemoveAnswerCommand}" Style="{StaticResource GhostButton}"
                                                Content="− 减一项" MinHeight="24" Padding="6,0" />
                                    </StackPanel>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Answers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="86" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"
                                                           FontSize="12.5" Foreground="{StaticResource BrushTextSecondary}" />
                                                <TextBox Grid.Column="1" Text="{Binding Answer, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource TextHint}" TextWrapping="Wrap"
                                           Text="答案必须与出厂预设完全一致。填写不足 2 项时程序会主动跳过该设备，避免白白消耗设备的尝试次数。" />
                            </StackPanel>

                            <!-- 方式 6：预留邮箱（邮箱本身在右侧二维码卡片里填） -->
                            <StackPanel Visibility="{Binding NeedMailBox, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource TextHint}" TextWrapping="Wrap"
                                           Text="该方式要求设备出厂时预留过安全邮箱。请在中间「② 扫码取回凭据」里确认或填写邮箱、生成二维码并扫码，安全码会发到该邮箱，再填回上方。" />
                            </StackPanel>

                            <!-- 方式 7：手机扫码（手机号在右侧二维码卡片里填） -->
                            <StackPanel Visibility="{Binding NeedPhone, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource TextHint}" TextWrapping="Wrap"
                                           Text="该方式要求设备上预留过手机号。请在中间「② 扫码取回凭据」里填写手机号、生成二维码并扫码，手机上会给出重置口令，再填回上方。" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ② 二维码：扫码取回凭据。放在中间，紧挨着它要回填的那一栏。
                         显示与否由 ShowQrPanel 决定，隐藏时整列（含 10px 间距）一起收掉。 -->
                    <Border Grid.Column="1" Width="360" Margin="10,0" Style="{StaticResource Card}" Padding="14"
                            Visibility="{Binding ShowQrPanel, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="② 扫码取回凭据" Style="{StaticResource TextSection}" />
                            <TextBlock Style="{StaticResource TextHint}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="{Binding QrTargetHint}" />

                            <ComboBox Margin="0,10,0,0" ItemsSource="{Binding QrSources}"
                                      DisplayMemberPath="Label"
                                      SelectedValue="{Binding SelectedQrSource}" SelectedValuePath="Value" />

                            <TextBlock Style="{StaticResource TextHint}" Margin="0,7,0,0" TextWrapping="Wrap"
                                       Text="{Binding QrSourceHint}" />

                            <!-- 手机扫码：需要设备上预留的手机号 -->
                            <StackPanel Margin="0,9,0,0"
                                        Visibility="{Binding NeedQrPhone, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="设备预留手机号" Style="{StaticResource TextLabel}" />
                                <TextBox Text="{Binding PhoneNo, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{StaticResource FontMono}" />
                            </StackPanel>

                            <!-- 预留邮箱：需要设备上预留的邮箱，可一键从设备读取 -->
                            <StackPanel Margin="0,9,0,0"
                                        Visibility="{Binding NeedQrMailBox, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="设备预留邮箱" Style="{StaticResource TextLabel}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding MailBox, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="{StaticResource FontMono}" />
                                    <Button Grid.Column="1" Command="{Binding ReadMailboxCommand}"
                                            Style="{StaticResource SecondaryButton}"
                                            Content="读取预留邮箱" Margin="6,0,0,0" />
                                </Grid>
                            </StackPanel>

                            <TextBlock Style="{StaticResource TextHint}" Margin="0,7,0,0" TextWrapping="Wrap"
                                       Text="{Binding QrInputHint}" />

                            <!-- 二维码展示区：260px 高对应 ViewModel 里的 250px 目标尺寸。
                                 这个尺寸是算出来的，不是拍脑袋的 —— 要保证每个模块 ≥2 物理像素，
                                 否则手机扫不出来（详见 PasswordResetViewModel.RenderQr 的注释）。
                                 NearestNeighbor + Uniform：整数倍缩放，模块边界不会被插值糊掉。 -->
                            <Border Margin="0,10,0,0" Height="260" CornerRadius="6"
                                    Background="{StaticResource BrushSurface}"
                                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                    ClipToBounds="True">
                                <Grid>
                                    <TextBlock Style="{StaticResource TextHint}" Margin="16" TextWrapping="Wrap"
                                               TextAlignment="Center" VerticalAlignment="Center"
                                               HorizontalAlignment="Center" IsHitTestVisible="False"
                                               Text="二维码会显示在这里。填好上面的信息后点下方「生成二维码」。"
                                               Visibility="{Binding HasQr, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                    <Image Source="{Binding QrImage}" Stretch="Uniform"
                                           Margin="4" SnapsToDevicePixels="True"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                </Grid>
                            </Border>

                            <TextBlock Style="{StaticResource TextHint}" Margin="0,7,0,0" TextWrapping="Wrap"
                                       Text="{Binding QrVersionText}" />
                            <TextBlock Style="{StaticResource TextHint}" Margin="0,5,0,0" TextWrapping="Wrap"
                                       Text="{Binding QrNotice}" />

                            <Button Command="{Binding LoadQrCommand}" Style="{StaticResource SoftButton}"
                                    Content="生成二维码" Margin="0,10,0,0" HorizontalAlignment="Stretch" />

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Center">
                                <Button Command="{Binding SaveQrCommand}" Style="{StaticResource SecondaryButton}"
                                        Content="保存图片" MinHeight="28" Padding="10,0" />
                                <Button Command="{Binding CopyQrImageCommand}" Style="{StaticResource GhostButton}"
                                        Content="复制图片" MinHeight="28" Padding="10,0" Margin="6,0,0,0" />
                                <Button Command="{Binding CopyQrContentCommand}" Style="{StaticResource GhostButton}"
                                        Content="复制内容" MinHeight="28" Padding="10,0" Margin="6,0,0,0" />
                                <Button Command="{Binding ClearQrCommand}" Style="{StaticResource GhostButton}"
                                        Content="清除" MinHeight="28" Padding="10,0" Margin="6,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ③ 新口令 -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="③ 设置新口令" Style="{StaticResource TextSection}" />

                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="新口令" Style="{StaticResource TextLabel}" />
                                <Grid>
                                    <PasswordBox views:PasswordBoxHelper.Attach="True"
                                                 Visibility="{Binding ShowPassword, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                                                 views:PasswordBoxHelper.BoundPassword="{Binding NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Text="{Binding NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Visibility="{Binding ShowPassword, Converter={StaticResource BoolToVisibility}}"
                                             FontFamily="{StaticResource FontMono}" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="再次输入" Style="{StaticResource TextLabel}" />
                                <Grid>
                                    <PasswordBox views:PasswordBoxHelper.Attach="True"
                                                 Visibility="{Binding ShowPassword, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                                                 views:PasswordBoxHelper.BoundPassword="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Text="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Visibility="{Binding ShowPassword, Converter={StaticResource BoolToVisibility}}"
                                             FontFamily="{StaticResource FontMono}" />
                                </Grid>
                            </StackPanel>

                            <ProgressBar Value="{Binding StrengthPercent, Mode=OneWay}" Maximum="100" Margin="0,12,0,6" />
                            <TextBlock Text="{Binding StrengthText}" Style="{StaticResource TextHint}" TextWrapping="Wrap" />

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Command="{Binding GeneratePasswordCommand}" Style="{StaticResource SecondaryButton}"
                                        Content="生成强口令" />
                                <Button Command="{Binding ToggleShowPasswordCommand}" Margin="8,0,0,0" MinWidth="76">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                            <Setter Property="Content" Value="显示明文" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowPassword}" Value="True">
                                                    <Setter Property="Content" Value="隐藏口令" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>

                            <Border Style="{StaticResource Divider}" Margin="0,14,0,12" />
                            <CheckBox Content="同时同步给下级 IPC（NVR / 通道设备）"
                                      IsChecked="{Binding SyncIpcPassword}" />
                            <TextBlock Style="{StaticResource TextHint}" Margin="25,5,0,0" TextWrapping="Wrap"
                                       Text="仅对支持该能力的录像机类设备有效。" />

                            <Border Style="{StaticResource Divider}" Margin="0,14,0,12" />
                            <TextBlock Style="{StaticResource TextHint}" TextWrapping="Wrap"
                                       Text="提示：SADP 连续失败会把设备锁定（部分固件错 3 次即锁 30 分钟）。同一台设备别反复试错，先看清失败原因再动手。" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ==================== 救援信息读取 ==================== -->
                <Expander Grid.Row="1" Header="④ 批量读取设备码 / GUID（可选，但推荐先读）"
                          Foreground="{StaticResource BrushTextSecondary}" FontSize="12.5" Margin="0,0,0,10">
                    <Border Style="{StaticResource Card}" Margin="0,8,0,0" Padding="14">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Command="{Binding ReadRecoveryInfoCommand}"
                                        Style="{StaticResource SoftButton}"
                                        Content="读取清单内设备的设备码 / GUID" MinWidth="220" />
                                <TextBlock Grid.Column="1" Style="{StaticResource TextHint}" VerticalAlignment="Center"
                                           Margin="16,0" TextWrapping="Wrap" Text="{Binding ProbeSummary}" />
                                <Button Grid.Column="2" Command="{Binding CopyRecoveryCommand}"
                                        Style="{StaticResource SecondaryButton}" Content="复制全部结果" />
                            </Grid>

                            <!-- 失败原因按 SADP 错误码归类后集中显示，这是"读不到设备码"最直接的答案 -->
                            <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="10,8"
                                    Background="{StaticResource BrushWarningSoft}"
                                    BorderBrush="{StaticResource BrushWarning}"
                                    Visibility="{Binding ProbeDetail, Converter={StaticResource NotEmptyToVisibility}}">
                                <TextBlock Text="{Binding ProbeDetail}" TextWrapping="Wrap" FontSize="12.5"
                                           Foreground="{StaticResource BrushWarning}" />
                            </Border>

                            <DataGrid ItemsSource="{Binding Recovery}" IsReadOnly="True" MaxHeight="190"
                                      Margin="0,12,0,0" SelectionMode="Single"
                                      SelectedItem="{Binding SelectedRecovery, Mode=TwoWay}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="目标" Binding="{Binding Target}" Width="140" />
                                    <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="120" />
                                    <DataGridTextColumn Header="设备码" Binding="{Binding DeviceCode}" Width="*" />
                                    <DataGridTextColumn Header="GUID" Binding="{Binding Guid}" Width="150" />
                                    <DataGridTextColumn Header="已配置找回方式" Binding="{Binding Ability}" Width="180" />
                                    <DataGridTextColumn Header="失败原因" Binding="{Binding DeviceCodeError}" Width="210" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Command="{Binding UseSelectedRecoveryCommand}" Style="{StaticResource SoftButton}"
                                        Content="用选中的设备码生成二维码" />
                                <TextBlock Style="{StaticResource TextHint}" Margin="12,0,0,0" VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           Text="先在表格里选中一行，再点这里；生成的码会直接出现在上方「② 扫码取回凭据」。" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Expander>

                <!-- ==================== 清单工具条 ==================== -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Command="{Binding LoadTargetsCommand}" Style="{StaticResource SoftButton}" Content="载入选中设备" />
                            <Button Command="{Binding UseAllDevicesCommand}" Style="{StaticResource GhostButton}" Content="载入全部设备" />
                            <Button Command="{Binding ClearTargetsCommand}" Style="{StaticResource GhostButton}" Content="清空清单" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Style="{StaticResource TextHint}" VerticalAlignment="Center"
                                   Margin="16,0" TextTrimming="CharacterEllipsis" Text="{Binding TargetSummary}" />
                    </Grid>
                </Border>

                <!-- ==================== 清单与结果 ==================== -->
                <Grid Grid.Row="3" MinHeight="280">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardTight}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="{StaticResource BrushSurfaceAlt}"
                                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="12,9">
                                <Grid>
                                    <TextBlock Text="待处理清单" Style="{StaticResource TextSection}" />
                                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource TextHint}"
                                               Text="{Binding TargetCount, StringFormat=共 {0} 台}" />
                                </Grid>
                            </Border>
                            <Grid>
                                <ListBox ItemsSource="{Binding Targets}" BorderThickness="0" Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="Bd" Background="Transparent" Padding="12,7"
                                                                BorderBrush="{StaticResource BrushDivider}" BorderThickness="0,0,0,1">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushSurfaceAlt}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <!-- 单选框：标明"二维码/读邮箱当前作用在哪台设备"。
                                                         选中态用多绑定引用相等比较同步（VM.SelectedTarget === 当前项）；
                                                         点选动作经 Command 写回 VM，样式不会被本地值锁死。 -->
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <RadioButton Grid.Column="0" GroupName="PwdResetQrTarget"
                                                             VerticalAlignment="Center" Margin="0,0,10,0"
                                                             ToolTip="勾选这台设备作为二维码 / 读邮箱的目标"
                                                             Command="{Binding DataContext.SelectTargetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                             CommandParameter="{Binding}">
                                                    <RadioButton.IsChecked>
                                                        <MultiBinding Mode="OneWay" Converter="{StaticResource ReferenceEqualsToBool}">
                                                            <Binding Path="DataContext.SelectedTarget" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                            <Binding />
                                                        </MultiBinding>
                                                    </RadioButton.IsChecked>
                                                </RadioButton>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding ModelText}" FontSize="12.5" />
                                                    <TextBlock FontSize="11" Margin="0,3,0,0"
                                                               Foreground="{StaticResource BrushTextMuted}">
                                                        <Run Text="{Binding IpMaskText, Mode=OneWay}" />
                                                        <Run Text="  ·  " />
                                                        <Run Text="{Binding SerialNo, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="24" Height="24"
                                                        Command="{Binding DataContext.RemoveTargetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" ToolTip="从清单移除">
                                                    <Path Style="{StaticResource IconPathSm}" Data="{StaticResource IconTrash}"
                                                          Stroke="{StaticResource BrushTextMuted}" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Style="{StaticResource TextHint}" Margin="16" TextWrapping="Wrap"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"
                                           MaxWidth="280"
                                           Visibility="{Binding Targets.Count, Converter={StaticResource EmptyToVisibility}}"
                                           Text="清单为空。先到「设备发现」页勾选设备并投递过来。" />
                            </Grid>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardTight}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="{StaticResource BrushSurfaceAlt}"
                                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="12,9">
                                <Grid>
                                    <TextBlock Text="执行结果" Style="{StaticResource TextSection}" />
                                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource TextHint}"
                                               Text="{Binding ResultSummary}" />
                                </Grid>
                            </Border>
                            <DataGrid ItemsSource="{Binding Results}" IsReadOnly="True" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="目标" Binding="{Binding Target}" Width="150" />
                                    <DataGridTemplateColumn Header="结论" Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Success}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource BrushSuccess}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="说明" Binding="{Binding Message}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
