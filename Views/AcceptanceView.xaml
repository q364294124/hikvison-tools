<UserControl x:Class="HikDeployTool.Views.AcceptanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:HikDeployTool.Views">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== 验收参数 ==================== -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="登录凭据" Style="{StaticResource TextSection}" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource TextHint}" VerticalAlignment="Center" Margin="10,0,0,0"
                               Text="验收必须真实登录设备才能判定，此处口令不会写入任何文件。" />
                </StackPanel>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="账号" Style="{StaticResource TextLabel}" />
                        <TextBox Width="130" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="口令" Style="{StaticResource TextLabel}" />
                        <Grid Width="230">
                            <PasswordBox x:Name="AcceptPwdBox"
                                         Visibility="{Binding ShowPassword, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                                         views:PasswordBoxHelper.Attach="True"
                                         views:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox x:Name="AcceptPwdPlain"
                                     Visibility="{Binding ShowPassword, Converter={StaticResource BoolToVisibility}}"
                                     Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{StaticResource FontMono}" />
                        </Grid>
                    </StackPanel>

                    <Button Grid.Column="2" MinWidth="76" VerticalAlignment="Bottom" Margin="0,0,16,0"
                            Command="{Binding ToggleShowPasswordCommand}"
                            ToolTip="切换明文 / 密文显示">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Setter Property="Content" Value="显示明文" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowPassword}" Value="True">
                                        <Setter Property="Content" Value="隐藏口令" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,16,0">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="时间容差（秒）" Style="{StaticResource TextLabel}" />
                            <TextBox Width="96"
                                     Text="{Binding TimeToleranceSeconds, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="设备时间与本机时间偏差超过该值即判不通过。录像检索对时间很敏感，建议 60 秒内。" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="每台抓图通道数" Style="{StaticResource TextLabel}" />
                            <TextBox Width="96"
                                     Text="{Binding CaptureChannels, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="0 表示不抓图；多通道设备可填 2~4 做多路存证。" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                        <TextBlock Text="检查项" Style="{StaticResource TextLabel}" />
                        <WrapPanel Margin="0,2,0,0">
                            <CheckBox Content="端口连通" IsChecked="{Binding CheckPort}" Margin="0,0,14,0" />
                            <CheckBox Content="登录认证" IsChecked="{Binding CheckLogin}" Margin="0,0,14,0" />
                            <CheckBox Content="读取设备信息" IsChecked="{Binding CheckDeviceInfo}" Margin="0,0,14,0" />
                            <CheckBox Content="序列号一致" IsChecked="{Binding CheckSerialMatch}" Margin="0,0,14,0" />
                            <CheckBox Content="设备时间" IsChecked="{Binding CheckTime}" Margin="0,0,14,0" />
                            <CheckBox Content="抓图存证" IsChecked="{Binding CheckSnapshot}" Margin="0,0,14,0" />
                            <Button Command="{Binding SelectAllChecksCommand}" Style="{StaticResource GhostButton}"
                                    Content="全选" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ==================== 目标清单工具条 ==================== -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="12">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding LoadTargetsCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                        Content="载入「设备发现」页勾选的设备" />
                <Button Command="{Binding UseAllDevicesCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                        Content="载入全部搜索结果" />
                <Button Command="{Binding LoadFromAssetsCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                        ToolTip="设备不在同一网段、广播搜不到时，用台账里的 IP 直接验收">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconPathSm}" Data="{StaticResource IconList}"
                              Stroke="{StaticResource BrushAccent}" Margin="0,0,6,0" />
                        <TextBlock Text="从资产台账载入" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ClearTargetsCommand}" Style="{StaticResource GhostButton}"
                        Content="清空清单" />

                <Border Width="1" Background="{StaticResource BrushDivider}" Margin="14,4,14,4" />

                <TextBlock Style="{StaticResource TextHint}" VerticalAlignment="Center"
                           Text="{Binding TargetSummary}" />

                <Border Style="{StaticResource ChipAccent}" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Style="{StaticResource ChipAccentText}" Text="{Binding AcceptanceSummary}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- ==================== 清单 + 结论 ==================== -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="320" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="5*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardTight}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="待验收清单" Style="{StaticResource TextSection}" Margin="12,10,12,6" />

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Targets}" IsReadOnly="True"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="IP 地址" Binding="{Binding IpMaskText}" Width="150" />
                            <DataGridTextColumn Header="序列号" Binding="{Binding SerialNo}" Width="130" />
                            <DataGridTextColumn Header="设备型号" Binding="{Binding ModelText}" Width="140" />
                            <DataGridTextColumn Header="SDK 端口" Binding="{Binding SdkPort}" Width="72" />
                            <DataGridTemplateColumn Header="激活" Width="72" SortMemberPath="Activate">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ActivateText}" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Activate}" Value="NotActivated">
                                                            <Setter Property="Foreground" Value="{StaticResource BrushWarning}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Activate}" Value="Activated">
                                                            <Setter Property="Foreground" Value="{StaticResource BrushSuccess}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="" Width="46" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.RemoveTargetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource IconButton}" Width="26" Height="26"
                                                ToolTip="从本次清单中移除">
                                            <Path Style="{StaticResource IconPathSm}" Data="{StaticResource IconTrash}"
                                                  Stroke="{StaticResource BrushTextMuted}" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding Targets.Count, Converter={StaticResource EmptyToVisibility}}"
                                IsHitTestVisible="False">
                        <Path Data="{StaticResource IconCheck}" Style="{StaticResource IconPath}"
                              Width="38" Height="38" Stroke="{StaticResource BrushBorderStrong}"
                              StrokeThickness="1.2" HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource TextHint}" HorizontalAlignment="Center" MaxWidth="300"
                                   TextAlignment="Center" Margin="0,10,0,0"
                                   Text="还没有待验收设备。先到「设备发现」页搜索并勾选，再点上面的「载入」。" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardTight}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,10,12,6">
                        <TextBlock Text="验收结论" Style="{StaticResource TextSection}" VerticalAlignment="Center" />
                        <Border Style="{StaticResource ChipSuccess}" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource ChipSuccessText}" Text="{Binding PassedCount, StringFormat='通过 {0}'}" />
                        </Border>
                        <Border Style="{StaticResource ChipWarning}" Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource ChipWarningText}" Text="{Binding PartialCount, StringFormat='部分未通过 {0}'}" />
                        </Border>
                        <Border Style="{StaticResource ChipDanger}" Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource ChipDangerText}" Text="{Binding FailedCount, StringFormat='失败 {0}'}" />
                        </Border>
                        <TextBlock Style="{StaticResource TextHint}" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Text="选中某一行可展开查看逐项检查明细" />
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Records}" IsReadOnly="True"
                              SelectionMode="Single"
                              RowDetailsVisibilityMode="VisibleWhenSelected">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="目标" Binding="{Binding Target}" Width="130" />
                            <DataGridTextColumn Header="IP 地址" Binding="{Binding Ip}" Width="124" />
                            <DataGridTextColumn Header="设备名称" Binding="{Binding DeviceName}" Width="126" />
                            <DataGridTextColumn Header="型号" Binding="{Binding Model}" Width="136" />
                            <DataGridTextColumn Header="固件版本" Binding="{Binding FirmwareVersion}" Width="112" />
                            <DataGridTextColumn Header="通道" Binding="{Binding ChannelCount}" Width="56" />
                            <DataGridTextColumn Header="时间偏差(秒)"
                                                Binding="{Binding DeviceTimeOffsetSeconds, StringFormat=F0}" Width="96" />
                            <DataGridTextColumn Header="检查项" Binding="{Binding CheckSummary}" Width="120" />

                            <DataGridTemplateColumn Header="结论" Width="98" SortMemberPath="ResultText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border VerticalAlignment="Center" HorizontalAlignment="Left"
                                                CornerRadius="9" Padding="8,2">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource Chip}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ResultText}" Value="通过">
                                                            <Setter Property="Background" Value="{StaticResource BrushSuccessSoft}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ResultText}" Value="部分未通过">
                                                            <Setter Property="Background" Value="{StaticResource BrushWarningSoft}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ResultText}" Value="失败">
                                                            <Setter Property="Background" Value="{StaticResource BrushDangerSoft}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding ResultText}" FontSize="11.5">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ResultText}" Value="通过">
                                                                <Setter Property="Foreground" Value="{StaticResource BrushSuccess}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ResultText}" Value="部分未通过">
                                                                <Setter Property="Foreground" Value="{StaticResource BrushWarning}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ResultText}" Value="失败">
                                                                <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="耗时(ms)" Binding="{Binding ElapsedMs}" Width="82" />
                        </DataGrid.Columns>

                        <!-- 展开行：逐项检查明细 + 抓图张数，现场复核时不用来回切页面 -->
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BrushSurfaceSunken}" Padding="12,8"
                                        BorderThickness="0,1,0,0" BorderBrush="{StaticResource BrushBorder}">
                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding Checks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="130" />
                                                            <ColumnDefinition Width="66" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                                   Foreground="{StaticResource BrushTextPrimary}"
                                                                   FontSize="12" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="12"
                                                                   VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource BrushSuccess}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Skipped}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Passed}" Value="False">
                                                                            <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="12"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{StaticResource BrushTextSecondary}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Style="{StaticResource TextHint}" Margin="0,6,0,0"
                                                   Visibility="{Binding Snapshots.Count, Converter={StaticResource NotEmptyToVisibility}}"
                                                   Text="{Binding Snapshots.Count, StringFormat='已抓图 {0} 张，保存在 output\snapshots'}" />
                                        <TextBlock Style="{StaticResource TextHint}" Margin="0,6,0,0"
                                                   Foreground="{StaticResource BrushDanger}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding Error, Converter={StaticResource NotEmptyToVisibility}}"
                                                   Text="{Binding Error}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                    </DataGrid>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding Records.Count, Converter={StaticResource EmptyToVisibility}}"
                                IsHitTestVisible="False">
                        <Path Data="{StaticResource IconReport}" Style="{StaticResource IconPath}"
                              Width="38" Height="38" Stroke="{StaticResource BrushBorderStrong}"
                              StrokeThickness="1.2" HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource TextHint}" HorizontalAlignment="Center" MaxWidth="320"
                                   TextAlignment="Center" Margin="0,10,0,0"
                                   Text="结论会在这里逐台累积；跑完整批后会自动生成一份带抓图的 HTML 报告。" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 执行条 ==================== -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Command="{Binding RunCommand}" Style="{StaticResource PrimaryButton}"
                        MinWidth="126" Margin="0,0,8,0" Content="{Binding RunButtonText}" />
                <Button Grid.Column="1" Command="{Binding CancelCommand}" Style="{StaticResource DangerButton}"
                        MinWidth="78" IsEnabled="{Binding IsRunning}" Content="取消" />

                <StackPanel Grid.Column="2" Margin="18,0,18,0" VerticalAlignment="Center">
                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" />
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <TextBlock Style="{StaticResource TextHint}" Text="{Binding ProgressText}" />
                        <TextBlock Style="{StaticResource TextHint}" Text=" · " />
                        <TextBlock Style="{StaticResource TextHint}" Text="{Binding AcceptanceSummary}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Command="{Binding GenerateReportCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            ToolTip="生成单文件 HTML 报告，可直接发甲方；浏览器里 Ctrl+P 即出 PDF">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPathSm}" Data="{StaticResource IconReport}"
                                  Stroke="{StaticResource BrushAccent}" Margin="0,0,6,0" />
                            <TextBlock Text="生成报告" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenSingleReportCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}"
                            Content="查看报告" />
                    <Button Command="{Binding OpenReportCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                            Content="报告目录" />
                    <Button Command="{Binding OpenSnapshotCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                            Content="抓图目录" />
                    <Button Command="{Binding ExportResultsCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                            Content="导出结果 CSV" />
                    <Button Command="{Binding ExportReportCsvCommand}" Style="{StaticResource GhostButton}"
                            Content="导出明细 CSV" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
