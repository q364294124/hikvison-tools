<UserControl x:Class="HikDeployTool.Views.AssetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:HikDeployTool.Views">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== 工具条 ==================== -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="12">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Grid.Column="0" Command="{Binding ImportFromDevicesCommand}"
                            Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                            ToolTip="把「设备发现」页勾选的设备写入台账；没勾选则并入全部搜索结果">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPathSm}" Data="{StaticResource IconImport}"
                                  Stroke="{StaticResource BrushTextOnAccent}" Margin="0,0,6,0" />
                            <TextBlock Text="搜索到的设备入库" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding AddManualCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            ToolTip="手工补录设备：弹窗支持 IP/域名（单台）、IP 段、批量导入三种模式；可选验证登录凭据，入库后自动检测在线状态">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPathSm}" Data="{StaticResource IconAdd}"
                                  Stroke="{StaticResource BrushAccent}" Margin="0,0,6,0" />
                            <TextBlock Text="手工新增" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding EditSelectedCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            ToolTip="编辑选中的台账记录：名称、位置、备注，以及 IP/端口/用户名/口令/序列号等（口令留空表示不修改）">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPathSm}" Data="{StaticResource IconEdit}"
                                  Stroke="{StaticResource BrushAccent}" Margin="0,0,6,0" />
                            <TextBlock Text="编辑" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SyncCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            ToolTip="用最新一次搜索结果刷新台账里的 IP、版本、在线状态（保留你填的名称与位置）">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPathSm}" Data="{StaticResource IconRefresh}"
                                  Stroke="{StaticResource BrushAccent}" Margin="0,0,6,0" />
                            <TextBlock Text="同步最新信息" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ProbeSelectedCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            ToolTip="检测选中的设备：探测端口在线状态；存有口令时真登录一次，确认激活状态并刷新序列号/型号/固件">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPathSm}" Data="{StaticResource IconSearch}"
                                  Stroke="{StaticResource BrushAccent}" Margin="0,0,6,0" />
                            <TextBlock Text="检测" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Border Width="1" Background="{StaticResource BrushDivider}" Margin="6,4,14,4" />

                    <Button Command="{Binding ImportCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Content="导入 CSV" />
                    <Button Command="{Binding ExportCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPathSm}" Data="{StaticResource IconExport}"
                                  Stroke="{StaticResource BrushAccent}" Margin="0,0,6,0" />
                            <TextBlock Text="导出 CSV" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenOutputCommand}" Style="{StaticResource GhostButton}"
                            Content="打开输出目录" />

                    <Border Width="1" Background="{StaticResource BrushDivider}" Margin="14,4,14,4" />

                    <Button Command="{Binding DeleteSelectedCommand}" Style="{StaticResource DangerButton}" Margin="0,0,8,0"
                            Content="删除选中" />
                    <Button Command="{Binding DeleteAllCommand}" Style="{StaticResource GhostButton}"
                            Content="清空台账" />
                </StackPanel>

                <Border Style="{StaticResource Divider}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="筛选" Style="{StaticResource TextLabel}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Grid.Column="1" Width="280"
                             Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="按编号 / 名称 / IP / 序列号 / MAC / 位置 / 备注模糊匹配" />
                    <TextBlock Grid.Column="2" Style="{StaticResource TextHint}" VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               Text="名称、安装位置、IP、备注可直接在表格里双击修改，改完自动存盘。" />
                    <Border Grid.Column="3" Style="{StaticResource ChipAccent}" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource ChipAccentText}" Text="{Binding StatsText}" />
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ==================== 台账表格 ==================== -->
        <Border Grid.Row="1" Style="{StaticResource CardTight}" Margin="0,0,0,10">
            <Grid>
                <DataGrid x:Name="AssetGrid"
                          ItemsSource="{Binding View}"
                          SelectedItem="{Binding Selected, Mode=TwoWay}"
                          SelectionMode="Single"
                          IsReadOnly="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CellEditEnding="AssetGrid_CellEditEnding">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="编号" Binding="{Binding Id}" Width="86" IsReadOnly="True" />

                        <DataGridTextColumn Header="设备名称" Binding="{Binding Name}" Width="150">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="ToolTip" Value="双击修改，例如「北门球机」" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="安装位置" Width="172" SortMemberPath="Location">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock Text="{Binding Location}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding Location, Converter={StaticResource NotEmptyToVisibility}}" />
                                        <TextBlock Text="双击填写位置…" VerticalAlignment="Center"
                                                   FontStyle="Italic" Foreground="{StaticResource BrushWarning}"
                                                   Visibility="{Binding Location, Converter={StaticResource EmptyToVisibility}}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="例如：1 号楼 3 层东侧走廊吊顶" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="IP 地址" Binding="{Binding Ip}" Width="126" />

                        <DataGridTextColumn Header="SDK 端口" Binding="{Binding Port}" Width="76" IsReadOnly="True" />

                        <DataGridTextColumn Header="序列号" Binding="{Binding SerialNo}" Width="132" IsReadOnly="True" />
                        <DataGridTextColumn Header="MAC" Binding="{Binding Mac}" Width="132" IsReadOnly="True" />
                        <DataGridTextColumn Header="设备型号" Binding="{Binding Model}" Width="146" IsReadOnly="True" />
                        <DataGridTextColumn Header="固件版本" Binding="{Binding FirmwareVersion}" Width="116" IsReadOnly="True" />

                        <DataGridTemplateColumn Header="激活" Width="74" SortMemberPath="ActivateState">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ActivateState}" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ActivateState}" Value="未激活">
                                                        <Setter Property="Foreground" Value="{StaticResource BrushWarning}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ActivateState}" Value="已激活">
                                                        <Setter Property="Foreground" Value="{StaticResource BrushSuccess}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="在线" Width="66" SortMemberPath="Online">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Online}" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Online}" Value="在线">
                                                        <Setter Property="Foreground" Value="{StaticResource BrushSuccess}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Online}" Value="离线">
                                                        <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="最近发现"
                                            Binding="{Binding LastSeen, StringFormat='MM-dd HH:mm'}"
                                            Width="106" IsReadOnly="True" />

                        <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="*" MinWidth="140">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="ToolTip" Value="可填写线缆走向、供电方式、甲方要求等" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 空状态：告诉用户"下一步该点哪里" -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding Assets.Count, Converter={StaticResource EmptyToVisibility}}"
                            IsHitTestVisible="False">
                    <Path Data="{StaticResource IconList}" Style="{StaticResource IconPath}"
                          Width="42" Height="42" Stroke="{StaticResource BrushBorderStrong}"
                          StrokeThickness="1.2" HorizontalAlignment="Center" />
                    <TextBlock Text="台账还是空的" HorizontalAlignment="Center" Margin="0,12,0,4"
                               Foreground="{StaticResource BrushTextSecondary}" FontSize="14" />
                    <TextBlock Style="{StaticResource TextHint}" HorizontalAlignment="Center" MaxWidth="440"
                               TextAlignment="Center"
                               Text="到「设备发现」页搜一遍设备，回来点左上角「搜索到的设备入库」，再补上每台设备的安装位置，就是一份能交付的清单。" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 底部提示 ==================== -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12">
            <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource IconPathSm}" Data="{StaticResource IconInfo}"
                      Stroke="{StaticResource BrushWarning}" VerticalAlignment="Top" Margin="0,2,8,0" />
                <StackPanel>
                    <TextBlock Style="{StaticResource TextHint}" TextWrapping="Wrap"
                               Text="台账保存在程序目录的 assets.json，导出目录可在「设置与自检」页修改。" />
                    <TextBlock Style="{StaticResource TextHint}" TextWrapping="Wrap" Margin="0,3,0,0"
                               Text="「位置」一栏建议写到「楼栋 + 楼层 + 朝向」的粒度，半年后有人问起才找得到设备。" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
