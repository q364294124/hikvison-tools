<UserControl x:Class="HikDeployTool.Views.DeviceDiscoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:HikDeployTool.Views"
             xmlns:models="clr-namespace:HikDeployTool.Models"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== 搜索控制条 ==================== -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="SearchButton" Grid.Column="0"
                        Command="{Binding ToggleSearchCommand}"
                        Content="{Binding SearchButtonText}"
                        MinWidth="112"
                        Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSearching}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource BrushDangerSoft}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource BrushDangerSoft}" />
                                    <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Grid.Column="1" Command="{Binding RefreshCommand}" Margin="0,0,8,0"
                        Style="{StaticResource SecondaryButton}" ToolTip="立即向局域网广播一次搜索请求">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconPathSm}" Data="{StaticResource IconRefresh}"
                              Stroke="{StaticResource BrushAccent}" Margin="0,0,6,0" />
                        <TextBlock Text="立即搜索" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" Command="{Binding ClearCommand}" Margin="0,0,16,0"
                        Style="{StaticResource SecondaryButton}"
                        ToolTip="清空列表，并让 SDK 忘记已缓存设备（换网段盘点时用）">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconPathSm}" Data="{StaticResource IconTrash}"
                              Stroke="{StaticResource BrushTextSecondary}" Margin="0,0,6,0" />
                        <TextBlock Text="清空列表" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="3" Margin="0,0,16,0">
                    <ComboBox ItemsSource="{Binding FilterOptions}"
                              SelectedItem="{Binding SelectedFilter}"
                              DisplayMemberPath="Label"
                              MinWidth="150"
                              ToolTip="按厂商过滤设备，可减少 OEM 贴牌设备的干扰" />
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="0,0,16,0">
                    <TextBlock Text="自动搜索间隔" Style="{StaticResource TextLabel}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="IntervalCombo" SelectedValue="{Binding SearchIntervalSeconds}"
                              SelectedValuePath="Tag" MinWidth="116"
                              ToolTip="SDK 定时广播搜索的频率；0 表示使用 SDK 默认的 60 秒">
                        <ComboBoxItem Content="默认（60 秒）" Tag="0" />
                        <ComboBoxItem Content="5 秒" Tag="5" />
                        <ComboBoxItem Content="10 秒" Tag="10" />
                        <ComboBoxItem Content="30 秒" Tag="30" />
                        <ComboBoxItem Content="60 秒" Tag="60" />
                        <ComboBoxItem Content="300 秒" Tag="300" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource Chip}" Margin="0,0,8,0">
                        <TextBlock Style="{StaticResource ChipText}" Text="{Binding SearchStateText}" />
                    </Border>
                    <TextBlock Style="{StaticResource TextHint}" VerticalAlignment="Center"
                               MaxWidth="320" Text="{Binding FilterSummary}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 设备表格 ==================== -->
        <Border Grid.Row="1" Style="{StaticResource CardTight}" Margin="0,0,0,10">
            <Grid>
                <DataGrid x:Name="DeviceGrid"
                          ItemsSource="{Binding Devices}"
                          SelectedItem="{Binding SelectedDevice}"
                          SelectionMode="Extended"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="勾选" Width="52" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center"
                                              ToolTip="勾选后可以投递到激活 / 网络 / 密码 / 验收页" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="状态" Width="88" SortMemberPath="LinkState">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border VerticalAlignment="Center" HorizontalAlignment="Left"
                                            CornerRadius="9" Padding="8,2">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource Chip}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LinkState}" Value="Online">
                                                        <Setter Property="Background" Value="{StaticResource BrushSuccessSoft}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding LinkState}" Value="New">
                                                        <Setter Property="Background" Value="{StaticResource BrushAccentSoft}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding LinkState}" Value="Updated">
                                                        <Setter Property="Background" Value="{StaticResource BrushAccentSoft}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding LinkState}" Value="Offline">
                                                        <Setter Property="Background" Value="{StaticResource BrushNeutralSoft}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding LinkState}" Value="UpdateFail">
                                                        <Setter Property="Background" Value="{StaticResource BrushDangerSoft}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding LinkStateText}" FontSize="11.5">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LinkState}" Value="Online">
                                                            <Setter Property="Foreground" Value="{StaticResource BrushSuccess}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding LinkState}" Value="New">
                                                            <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding LinkState}" Value="Updated">
                                                            <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding LinkState}" Value="UpdateFail">
                                                            <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="激活状态" Width="86" SortMemberPath="Activate">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ActivateText}" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Activate}" Value="NotActivated">
                                                        <Setter Property="Foreground" Value="{StaticResource BrushWarning}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Activate}" Value="Activated">
                                                        <Setter Property="Foreground" Value="{StaticResource BrushSuccess}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="IP 地址 / 掩码" Binding="{Binding IpMaskText}" Width="150" />
                        <DataGridTextColumn Header="MAC" Binding="{Binding Mac}" Width="140" />
                        <DataGridTextColumn Header="序列号" Binding="{Binding SerialNo}" Width="130" />
                        <DataGridTextColumn Header="设备型号" Binding="{Binding ModelText}" Width="150" />
                        <DataGridTextColumn Header="固件版本" Binding="{Binding SoftwareVersion}" Width="130" />
                        <DataGridTextColumn Header="厂商" Binding="{Binding Manufacturer}" Width="90" />
                        <DataGridTextColumn Header="SDK 端口" Binding="{Binding SdkPort}" Width="72" />
                        <DataGridTextColumn Header="HTTP 端口" Binding="{Binding HttpPort}" Width="76" />
                        <DataGridTextColumn Header="通道数" Binding="{Binding DigitalChannelCount}" Width="62" />
                        <DataGridTextColumn Header="最近发现" Binding="{Binding LastSeen, StringFormat=HH:mm:ss}" Width="86" />

                        <DataGridTemplateColumn Header="特性" Width="150" SortMemberPath="SupportResetPasswd">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border x:Name="ChipDhcp" Style="{StaticResource Chip}" Padding="6,1" Margin="0,0,4,0"
                                                Visibility="{Binding DhcpEnabled, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Style="{StaticResource ChipText}" Text="DHCP" FontSize="10.5" />
                                        </Border>
                                        <Border Style="{StaticResource Chip}" Padding="6,1" Margin="0,0,4,0"
                                                Visibility="{Binding IsOem, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Style="{StaticResource ChipText}" Text="OEM" FontSize="10.5" />
                                        </Border>
                                        <Border Style="{StaticResource Chip}" Padding="6,1" Margin="0,0,4,0"
                                                Visibility="{Binding IsEzViz, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Style="{StaticResource ChipText}" Text="萤石" FontSize="10.5" />
                                        </Border>
                                        <Border Style="{StaticResource ChipWarning}" Padding="6,1" Margin="0,0,4,0"
                                                Visibility="{Binding IsLicenseMissing, Converter={StaticResource BoolToVisibility}}"
                                                ToolTip="设备缺少授权，功能可能受限">
                                            <TextBlock Style="{StaticResource ChipWarningText}" Text="无授权" FontSize="10.5" />
                                        </Border>
                                        <Border Style="{StaticResource ChipDanger}" Padding="6,1"
                                                Visibility="{Binding IsDiscoveryOnly, Converter={StaticResource BoolToVisibility}}"
                                                ToolTip="仅能被发现，无法修改参数（常见于下级平台纳管的设备）">
                                            <TextBlock Style="{StaticResource ChipDangerText}" Text="只读" FontSize="10.5" />
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 空状态引导：比一张空表格有用得多 -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding Devices.Count, Converter={StaticResource EmptyToVisibility}}"
                            IsHitTestVisible="False">
                    <Path Data="{StaticResource IconSearch}" Style="{StaticResource IconPath}"
                          Width="42" Height="42" Stroke="{StaticResource BrushBorderStrong}"
                          StrokeThickness="1.2" HorizontalAlignment="Center" />
                    <TextBlock Text="还没有发现设备" HorizontalAlignment="Center" Margin="0,12,0,4"
                               Foreground="{StaticResource BrushTextSecondary}" FontSize="14" />
                    <TextBlock Style="{StaticResource TextHint}" HorizontalAlignment="Center" MaxWidth="420"
                               TextAlignment="Center"
                               Text="点左上角「开始搜索」。若搜索一直为空：确认本机与设备在同一网段、已安装 Npcap、并以管理员身份运行；跨网段设备请用下方的「网段扫描」。" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 勾选与投递 ==================== -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="勾选" Style="{StaticResource TextLabel}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Command="{Binding SelectAllCommand}" Style="{StaticResource GhostButton}" Content="全选" />
                    <Button Command="{Binding InvertSelectionCommand}" Style="{StaticResource GhostButton}" Content="反选" />
                    <Button Command="{Binding ClearSelectionCommand}" Style="{StaticResource GhostButton}" Content="清空勾选" />
                    <Button Command="{Binding SelectNotActivatedCommand}" Style="{StaticResource SoftButton}"
                            Content="只勾选未激活" Margin="4,0,0,0" />

                    <Border Width="1" Background="{StaticResource BrushDivider}" Margin="14,4,14,4" />

                    <TextBlock Text="下一步" Style="{StaticResource TextLabel}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Command="{Binding GoActivateCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPathSm}" Data="{StaticResource IconBolt}"
                                  Stroke="{StaticResource BrushAccent}" Margin="0,0,6,0" />
                            <TextBlock Text="批量激活" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding GoNetworkCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPathSm}" Data="{StaticResource IconNetwork}"
                                  Stroke="{StaticResource BrushAccent}" Margin="0,0,6,0" />
                            <TextBlock Text="改网络参数" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding GoPasswordCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPathSm}" Data="{StaticResource IconKey}"
                                  Stroke="{StaticResource BrushAccent}" Margin="0,0,6,0" />
                            <TextBlock Text="重置密码" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding GoAcceptanceCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPathSm}" Data="{StaticResource IconCheck}"
                                  Stroke="{StaticResource BrushAccent}" Margin="0,0,6,0" />
                            <TextBlock Text="设备验收" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 入库验证凭据：台账里的设备其它页面（预览/验收）都直接信，
                     所以入库前必须逐台登录验证；未激活设备在这里被拦下，先去激活。 -->
                <Border Style="{StaticResource Divider}" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="入库验证" Style="{StaticResource TextLabel}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="用户名" Style="{StaticResource TextLabel}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Text="{Binding AssetUserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Width="110" VerticalAlignment="Center" />
                    <TextBlock Text="口令" Style="{StaticResource TextLabel}" VerticalAlignment="Center" Margin="12,0,6,0" />
                    <Grid VerticalAlignment="Center">
                        <PasswordBox views:PasswordBoxHelper.Attach="True"
                                     Width="150"
                                     Visibility="{Binding ShowAssetPassword, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                                     views:PasswordBoxHelper.BoundPassword="{Binding AssetPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Text="{Binding AssetPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Width="150"
                                 Visibility="{Binding ShowAssetPassword, Converter={StaticResource BoolToVisibility}}"
                                 FontFamily="{StaticResource FontMono}" />
                    </Grid>
                    <Button Command="{Binding ToggleAssetPasswordCommand}" Style="{StaticResource IconButton}"
                            Width="22" Height="22" Margin="4,0,0,0" VerticalAlignment="Center"
                            ToolTip="显示 / 隐藏口令">
                        <Path>
                            <Path.Style>
                                <Style TargetType="Path" BasedOn="{StaticResource IconPathSm}">
                                    <Setter Property="Data" Value="{StaticResource IconEye}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowAssetPassword}" Value="True">
                                            <Setter Property="Data" Value="{StaticResource IconEyeOff}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>
                    <Button Command="{Binding VerifyAndAddCommand}" Style="{StaticResource PrimaryButton}"
                            Margin="14,0,0,0" MinWidth="120"
                            ToolTip="勾选的设备逐台登录验证，凭据正确的并入台账；未激活设备会提示先去激活">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPathSm}" Data="{StaticResource IconList}"
                                  Stroke="{StaticResource BrushTextOnAccent}" Margin="0,0,6,0" />
                            <TextBlock Text="验证并入库" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding AssetVerifyStatus}" Margin="12,0,0,0" FontSize="12"
                               VerticalAlignment="Center" Foreground="{StaticResource BrushTextMuted}" />
                </StackPanel>

                <!-- 设备码：密码救援流程的第一环，放在这里顺手就能拿到 -->
                <Border Style="{StaticResource Divider}" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="设备码" Style="{StaticResource TextLabel}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Command="{Binding GenerateDeviceCodeCommand}" Style="{StaticResource GhostButton}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPathSm}" Data="{StaticResource IconTag}"
                                  Stroke="{StaticResource BrushTextSecondary}" Margin="0,0,6,0" />
                            <TextBlock Text="读取选中设备码" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Border Style="{StaticResource Card}" Padding="10,5" Margin="10,0,0,0"
                            Background="{StaticResource BrushSurfaceAlt}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="DeviceCodeText" Style="{StaticResource TextMono}"
                                       VerticalAlignment="Center" MinWidth="180"
                                       Text="{Binding LastDeviceCode}" />
                            <Button Command="{Binding CopyDeviceCodeCommand}" Style="{StaticResource IconButton}"
                                    Width="24" Height="24" Margin="8,0,0,0" ToolTip="复制设备码"
                                    Visibility="{Binding LastDeviceCode, Converter={StaticResource NotEmptyToVisibility}}">
                                <Path Style="{StaticResource IconPathSm}" Data="{StaticResource IconCopy}"
                                      Stroke="{StaticResource BrushTextSecondary}" />
                            </Button>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource TextHint}" VerticalAlignment="Center" Margin="12,0,0,0"
                               Text="设备码是密码重置的凭据，请勿外传（可配合设备序列号一起抄在工单上）。" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ==================== 网段扫描（兜底手段） ==================== -->
        <Expander Grid.Row="3" Header="跨网段扫描（广播搜不到时的补救手段）"
                  Foreground="{StaticResource BrushTextSecondary}" FontSize="12.5">
            <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource TextHint}" Margin="0,0,0,10"
                               Text="广播包只在同一个二层网段内传播。若设备在别的网段或 VLAN，就把它的网段范围填进来逐个探测。注意：这里只能证明「这个地址上有设备」，拿不到序列号与激活状态，需要网络先做通路由才能用其它功能页。" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="起始 IP" Style="{StaticResource TextLabel}" />
                            <TextBox Width="128" Text="{Binding StartIp, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="结束 IP" Style="{StaticResource TextLabel}" />
                            <TextBox Width="128" Text="{Binding StopIp, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,10,0">
                            <TextBlock Text="SDK 端口" Style="{StaticResource TextLabel}" />
                            <TextBox Width="80" Text="{Binding ProbeSdkPort, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="0,0,10,0">
                            <TextBlock Text="HTTP 端口" Style="{StaticResource TextLabel}" />
                            <TextBox Width="80" Text="{Binding ProbeHttpPort, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <CheckBox Grid.Column="4" Content="IP 探测（Ping）" IsChecked="{Binding IpProbeEnabled}"
                                  VerticalAlignment="Bottom" Margin="0,0,12,8" />
                        <CheckBox Grid.Column="5" Content="端口探测（TCP）" IsChecked="{Binding PortProbeEnabled}"
                                  VerticalAlignment="Bottom" Margin="0,0,12,8" />

                        <Button Grid.Column="6" Command="{Binding GuessSubnetCommand}" Style="{StaticResource GhostButton}"
                                VerticalAlignment="Bottom" Margin="0,0,10,2"
                                Content="按本机网段填充" ToolTip="读取本机网卡的 IPv4 地址，自动填 .1 ~ .254" />

                        <Button x:Name="ProbeButton" Grid.Column="7" Command="{Binding ToggleProbeCommand}"
                                Style="{StaticResource PrimaryButton}" MinWidth="104" Margin="0,0,14,2"
                                VerticalAlignment="Bottom" Content="{Binding ProbeButtonText}" />

                        <StackPanel Grid.Column="8" VerticalAlignment="Bottom" Margin="0,0,10,2">
                            <ProgressBar Value="{Binding ProbeProgress, Mode=OneWay}" Maximum="100" />
                            <TextBlock Style="{StaticResource TextHint}" Margin="0,5,0,0">
                                <Run Text="{Binding ProbeStatus, Mode=OneWay}" />
                                <Run Text=" · " />
                                <Run Text="{Binding ProbeProgressText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>

                        <Button Grid.Column="9" Command="{Binding CopyProbeToClipboardCommand}"
                                Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom" Margin="0,0,0,2"
                                Content="复制结果" />
                    </Grid>

                    <DataGrid ItemsSource="{Binding ProbeResults}" MaxHeight="180" Margin="0,12,0,0"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="IP 地址" Binding="{Binding IP}" Width="160" />
                            <DataGridTextColumn Header="端口" Binding="{Binding Port}" Width="90" />
                            <DataGridTextColumn Header="协议" Binding="{Binding Protocol}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </Expander>
    </Grid>
</UserControl>
