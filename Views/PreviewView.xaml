<UserControl x:Class="HikDeployTool.Views.PreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:HikDeployTool.Views"
             xmlns:vm="clr-namespace:HikDeployTool.ViewModels"
             xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms">

    <!--
      版面说明（改之前先看）：

      左窄右宽两栏：
        左栏 300px  —— 设备树（两层：设备 → 通道）+ 凭据 + 码流与分屏；
        右栏自适应 —— 多画面宫格（每格 WindowsFormsHost 承载一个 WinForms Panel）。

      几条硬约束：
        1. 视频必须用 WindowsFormsHost 承载 WinForms Panel —— SDK 的 hPlayWnd 模式
           只认原生窗口句柄，WPF 元素没有 HWND。代价是空域（airspace）问题：
           WinForms 区域永远盖在 WPF 内容之上，所以每格的状态条必须
           放在视频区**外部**的独立行里，不能叠在画面上；
        2. 格子是数据驱动的（ItemsControl + UniformGrid），但每格的 Panel 句柄
           要回灌给 ViewModel —— 交给自定义控件 TileHost 在 Loaded 时
           调 vm.StartTileAsync(tile, panel.Handle) 完成绑定；
        3. 分屏数变化会重建所有格子容器 → 旧 Panel 销毁 → 必须重取流。
           TileHost 的 Unloaded 里要通知 VM 收掉旧句柄，否则会往死窗口推流。
    -->

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== 左栏：设备树与参数 ==================== -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 设备树标题 + 刷新 -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="设备与通道" Style="{StaticResource TextSection}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Command="{Binding RefreshCommand}" Style="{StaticResource IconButton}"
                            Width="24" Height="24" ToolTip="刷新（已发现 + 台账）">
                        <Path Style="{StaticResource IconPathSm}" Data="{StaticResource IconRefresh}" />
                    </Button>
                </Grid>

                <!-- 设备树本体：设备 → 通道 两层 -->
                <Border Grid.Row="1" BorderBrush="{StaticResource BrushDivider}" BorderThickness="1"
                        CornerRadius="8" Background="{StaticResource BrushSurfaceAlt}" Padding="2">
                    <Grid>
                        <TreeView ItemsSource="{Binding Tree}" BorderThickness="0" Background="Transparent"
                                  SelectedItemChanged="OnTreeSelectionChanged"
                                  VirtualizingPanel.IsVirtualizing="False">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <Setter Property="Padding" Value="2,1" />
                                    <EventSetter Event="MouseDoubleClick" Handler="OnTreeItemDoubleClick" />
                                </Style>
                            </TreeView.ItemContainerStyle>

                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate DataType="{x:Type vm:PreviewTreeNode}"
                                                          ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <Path VerticalAlignment="Center" Margin="0,0,6,0">
                                            <Path.Style>
                                                <Style TargetType="Path" BasedOn="{StaticResource IconPathSm}">
                                                    <Setter Property="Data" Value="{StaticResource IconEye}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDevice}" Value="False">
                                                            <Setter Property="Data" Value="{StaticResource IconCamera}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsLoggedIn}" Value="True">
                                                            <Setter Property="Stroke" Value="{StaticResource BrushSuccess}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" FontSize="12" />
                                            <TextBlock FontSize="10.5" Foreground="{StaticResource BrushTextMuted}"
                                                       Text="{Binding StateText}" />
                                        </StackPanel>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>

                        <!-- 空态：树为空时盖在上面 -->
                        <TextBlock TextAlignment="Center" TextWrapping="Wrap" FontSize="11.5"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding TreeEmpty, Converter={StaticResource BoolToVisibility}}"
                                   Text="暂无可用设备&#x0a;请先到「设备发现」搜索并「验证并入库」" />
                    </Grid>
                </Border>

                <!-- 码流 + 分屏 + 断开 -->
                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <Border Style="{StaticResource Divider}" />
                    <TextBlock Text="码流" Style="{StaticResource TextLabel}" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <RadioButton Grid.Column="0" Content="主码流"
                                     IsChecked="{Binding UseSubStream, Converter={StaticResource InverseBoolean}}"
                                     ToolTip="分辨率高，单画面看清晰度用；多画面时很吃带宽。切换立即对已开画面生效（自动重开）" />
                        <RadioButton Grid.Column="1" Content="子码流"
                                     IsChecked="{Binding UseSubStream}"
                                     ToolTip="分辨率低、占用小；多画面 / 无线 / 跨网段建议用这个。切换立即对已开画面生效（自动重开）" />
                    </Grid>

                    <TextBlock Text="通道" Style="{StaticResource TextLabel}" Margin="0,10,0,0" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Content="打开音频"
                                  IsChecked="{Binding AudioEnabled, Mode=TwoWay}"
                                  ToolTip="打开预览声音（需先有画面在播）。解码渲染模式下声音是全局开关：多画面在播时只混播一路，关掉最后一格画面或离开本页会自动静音。" />
                        <Button Grid.Column="1" Command="{Binding OpenChannelManagerCommand}"
                                Style="{StaticResource GhostButton}" MinHeight="26" Padding="10,0"
                                Margin="8,0,0,0" ToolTip="逐通道缩略图 + 手动勾选显隐（优先于自动过滤）+ OSD 名称同步">
                            <TextBlock Text="通道管理" FontSize="11.5" VerticalAlignment="Center" />
                        </Button>
                    </Grid>

                    <TextBlock Text="分屏" Style="{StaticResource TextLabel}" Margin="0,10,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Command="{Binding Grid1Command}" Style="{StaticResource GhostButton}"
                                MinWidth="34" ToolTip="单画面">
                            <Path Style="{StaticResource IconPathSm}" Data="{StaticResource IconLayout1}" />
                        </Button>
                        <Button Command="{Binding Grid4Command}" Style="{StaticResource GhostButton}"
                                MinWidth="34" Margin="6,0,0,0" ToolTip="四画面">
                            <Path Style="{StaticResource IconPathSm}" Data="{StaticResource IconLayout4}" />
                        </Button>
                        <Button Command="{Binding Grid9Command}" Style="{StaticResource GhostButton}"
                                MinWidth="34" Margin="6,0,0,0" ToolTip="九画面">
                            <Path Style="{StaticResource IconPathSm}" Data="{StaticResource IconLayout9}" />
                        </Button>
                        <TextBlock Text="{Binding GridSummary}" FontSize="11.5" VerticalAlignment="Center"
                                   Margin="10,0,0,0" Foreground="{StaticResource BrushTextSecondary}" />
                    </StackPanel>

                    <Button Command="{Binding LogoutAllCommand}" Style="{StaticResource SecondaryButton}"
                            Content="断开全部连接" Margin="0,10,0,0" />
                </StackPanel>

                <TextBlock Grid.Row="3" Style="{StaticResource TextHint}" Margin="0,10,0,0" FontSize="11"
                           TextWrapping="Wrap"
                           Text="入库设备进页面自动登录（免密直连）→ 双击通道开一格。未入库的设备请先到「设备发现」页「验证并入库」，入库时验证过的口令会加密保存，之后这里全程免密。双击画面放大/还原；选中球机画面时下方出现云台；切换码流立即对已开画面生效。离开本页会自动断开全部。" />
            </Grid>
        </Border>

        <!-- ==================== 右栏：多画面宫格 + 云台 + 操作条 ==================== -->
        <Border Grid.Column="2" Style="{StaticResource CardTight}" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 宫格：ItemsControl + UniformGrid，行列数绑 VM 的 GridRows/GridColumns -->
                <ItemsControl Grid.Row="0" x:Name="TileGrid" ItemsSource="{Binding Tiles}">
                    <!-- 放大时隐藏其它格：**必须做在容器（ContentPresenter）上**。
                         曾经做在模板内部的 Border 上，容器照样占位 —— UniformGrid 的
                         ArrangeOverride 是按行排的：Rows=Columns=1 时它仍然依次把第 2、3、4 个
                         子项排到"下一行"（即可视区下方），表现就是"只有第一格放大正常，
                         其它格一放大就错位/消失"。容器 Collapsed 才会被 UniformGrid 跳过。 -->
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.ItemContainerStyle>

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="{Binding DataContext.GridRows, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                         Columns="{Binding DataContext.GridColumns, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- 每一格：标题条（上）+ 视频区（下）。
                                 标题条放在视频区外面 —— 空域问题，叠在 WinForms 上的 WPF 元素看不见。 -->
                            <Border BorderBrush="#2A2F38" BorderThickness="1" Background="Black" Margin="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Background="#1B1F26" Padding="8,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center"
                                                     Margin="0,0,7,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource BrushTextMuted}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLive}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource BrushSuccess}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>

                                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="11.5"
                                                       Foreground="#E6EAF0" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />

                                            <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="11"
                                                       Foreground="#8D9AAA" VerticalAlignment="Center"
                                                       Margin="8,0,6,0" />

                                            <Button Grid.Column="3" Style="{StaticResource IconButton}"
                                                    Width="20" Height="20"
                                                    Command="{Binding DataContext.CloseTileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="关闭这一路">
                                                <Path Style="{StaticResource IconPathSm}" Data="{StaticResource IconClose}"
                                                      Stroke="#B8C2CE" />
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- 视频区：自定义宿主控件，负责把 Panel 句柄交给 VM 并触发取流。
                                         Owner 必须显式绑定——模板内 DataContext 是 PreviewTile，
                                         控件自己找不到 VM（少了这个绑定就静默黑屏）。 -->
                                    <views:TileHost Grid.Row="1" Tile="{Binding}"
                                                    Owner="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 宫格为空时的提示（数据模板只在有数据时渲染，空态单独放） -->
                <TextBlock Grid.Row="0" Text="双击左侧通道即可开窗"
                           FontSize="13" Foreground="#5A6472"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Tiles.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- 云台面板：仅当选中格设备实测支持云台时出现（ISAPI capabilities 探测）。
                     放在画面区外部的独立行 —— 空域原因，叠在 WinForms 上的 WPF 元素看不见。 -->
                <Border Grid.Row="1" Background="{StaticResource BrushSurfaceAlt}"
                        BorderBrush="{StaticResource BrushDivider}" BorderThickness="0,1,0,0"
                        Padding="16,8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PtzVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 摇杆 3×3：按住转动、松开停止（Tag = PTZ 命令码，事件统一挂在 code-behind） -->
                        <Grid Grid.Column="0" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 方向箭头：同一份 Path，旋转摆出八个方向 -->
                            <Button Grid.Row="0" Grid.Column="0" Tag="25" Style="{StaticResource IconButton}"
                                    Width="34" Height="34" Margin="1" ToolTip="左上"
                                    PreviewMouseDown="OnPtzButtonDown" PreviewMouseUp="OnPtzButtonUp" MouseLeave="OnPtzButtonLeave">
                                <Path Style="{StaticResource IconPathSm}" Data="{StaticResource IconArrow}" Stroke="#B8C2CE">
                                    <Path.RenderTransform><RotateTransform Angle="-45" /></Path.RenderTransform>
                                </Path>
                            </Button>
                            <Button Grid.Row="0" Grid.Column="1" Tag="21" Style="{StaticResource IconButton}"
                                    Width="34" Height="34" Margin="1" ToolTip="上"
                                    PreviewMouseDown="OnPtzButtonDown" PreviewMouseUp="OnPtzButtonUp" MouseLeave="OnPtzButtonLeave">
                                <Path Style="{StaticResource IconPathSm}" Data="{StaticResource IconArrow}" Stroke="#B8C2CE" />
                            </Button>
                            <Button Grid.Row="0" Grid.Column="2" Tag="26" Style="{StaticResource IconButton}"
                                    Width="34" Height="34" Margin="1" ToolTip="右上"
                                    PreviewMouseDown="OnPtzButtonDown" PreviewMouseUp="OnPtzButtonUp" MouseLeave="OnPtzButtonLeave">
                                <Path Style="{StaticResource IconPathSm}" Data="{StaticResource IconArrow}" Stroke="#B8C2CE">
                                    <Path.RenderTransform><RotateTransform Angle="45" /></Path.RenderTransform>
                                </Path>
                            </Button>
                            <Button Grid.Row="1" Grid.Column="0" Tag="23" Style="{StaticResource IconButton}"
                                    Width="34" Height="34" Margin="1" ToolTip="左"
                                    PreviewMouseDown="OnPtzButtonDown" PreviewMouseUp="OnPtzButtonUp" MouseLeave="OnPtzButtonLeave">
                                <Path Style="{StaticResource IconPathSm}" Data="{StaticResource IconArrow}" Stroke="#B8C2CE">
                                    <Path.RenderTransform><RotateTransform Angle="-90" /></Path.RenderTransform>
                                </Path>
                            </Button>
                            <Ellipse Grid.Row="1" Grid.Column="1" Width="6" Height="6"
                                     Fill="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Button Grid.Row="1" Grid.Column="2" Tag="24" Style="{StaticResource IconButton}"
                                    Width="34" Height="34" Margin="1" ToolTip="右"
                                    PreviewMouseDown="OnPtzButtonDown" PreviewMouseUp="OnPtzButtonUp" MouseLeave="OnPtzButtonLeave">
                                <Path Style="{StaticResource IconPathSm}" Data="{StaticResource IconArrow}" Stroke="#B8C2CE">
                                    <Path.RenderTransform><RotateTransform Angle="90" /></Path.RenderTransform>
                                </Path>
                            </Button>
                            <Button Grid.Row="2" Grid.Column="0" Tag="27" Style="{StaticResource IconButton}"
                                    Width="34" Height="34" Margin="1" ToolTip="左下"
                                    PreviewMouseDown="OnPtzButtonDown" PreviewMouseUp="OnPtzButtonUp" MouseLeave="OnPtzButtonLeave">
                                <Path Style="{StaticResource IconPathSm}" Data="{StaticResource IconArrow}" Stroke="#B8C2CE">
                                    <Path.RenderTransform><RotateTransform Angle="-135" /></Path.RenderTransform>
                                </Path>
                            </Button>
                            <Button Grid.Row="2" Grid.Column="1" Tag="22" Style="{StaticResource IconButton}"
                                    Width="34" Height="34" Margin="1" ToolTip="下"
                                    PreviewMouseDown="OnPtzButtonDown" PreviewMouseUp="OnPtzButtonUp" MouseLeave="OnPtzButtonLeave">
                                <Path Style="{StaticResource IconPathSm}" Data="{StaticResource IconArrow}" Stroke="#B8C2CE">
                                    <Path.RenderTransform><RotateTransform Angle="180" /></Path.RenderTransform>
                                </Path>
                            </Button>
                            <Button Grid.Row="2" Grid.Column="2" Tag="28" Style="{StaticResource IconButton}"
                                    Width="34" Height="34" Margin="1" ToolTip="右下"
                                    PreviewMouseDown="OnPtzButtonDown" PreviewMouseUp="OnPtzButtonUp" MouseLeave="OnPtzButtonLeave">
                                <Path Style="{StaticResource IconPathSm}" Data="{StaticResource IconArrow}" Stroke="#B8C2CE">
                                    <Path.RenderTransform><RotateTransform Angle="135" /></Path.RenderTransform>
                                </Path>
                            </Button>
                        </Grid>

                        <!-- 变倍 / 聚焦 -->
                        <Grid Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Row="0" Grid.Column="0" Tag="11" Style="{StaticResource GhostButton}"
                                    MinHeight="28" Padding="10,0" Margin="2" Content="变倍 +"
                                    PreviewMouseDown="OnPtzButtonDown" PreviewMouseUp="OnPtzButtonUp" MouseLeave="OnPtzButtonLeave" />
                            <Button Grid.Row="0" Grid.Column="1" Tag="12" Style="{StaticResource GhostButton}"
                                    MinHeight="28" Padding="10,0" Margin="2" Content="变倍 −"
                                    PreviewMouseDown="OnPtzButtonDown" PreviewMouseUp="OnPtzButtonUp" MouseLeave="OnPtzButtonLeave" />
                            <Button Grid.Row="1" Grid.Column="0" Tag="13" Style="{StaticResource GhostButton}"
                                    MinHeight="28" Padding="10,0" Margin="2" Content="聚焦 +"
                                    PreviewMouseDown="OnPtzButtonDown" PreviewMouseUp="OnPtzButtonUp" MouseLeave="OnPtzButtonLeave" />
                            <Button Grid.Row="1" Grid.Column="1" Tag="14" Style="{StaticResource GhostButton}"
                                    MinHeight="28" Padding="10,0" Margin="2" Content="聚焦 −"
                                    PreviewMouseDown="OnPtzButtonDown" PreviewMouseUp="OnPtzButtonUp" MouseLeave="OnPtzButtonLeave" />
                        </Grid>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock Text="虚拟云台" Style="{StaticResource TextSection}" />
                            <TextBlock Text="按住方向键转动、松开停止 · 控制的是当前选中的那一路画面"
                                       Style="{StaticResource TextHint}" FontSize="11" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 操作条：放在宫格下方（空域原因，不能叠在画面上） -->
                <Border Grid.Row="2" Background="{StaticResource BrushSurfaceAlt}"
                        BorderBrush="{StaticResource BrushDivider}" BorderThickness="0,1,0,0"
                        Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding SnapshotCommand}" Style="{StaticResource SecondaryButton}"
                                    MinHeight="28" Padding="12,0" Content="抓图存证"
                                    ToolTip="对当前选中的那一路抓图，存到 output\snapshots\preview" />
                            <Button Command="{Binding CloseAllCommand}" Style="{StaticResource GhostButton}"
                                    MinHeight="28" Padding="10,0" Content="全部关闭" Margin="8,0,0,0" />
                            <Button Command="{Binding OpenSnapshotsCommand}" Style="{StaticResource GhostButton}"
                                    MinHeight="28" Padding="10,0" Content="快照目录" Margin="8,0,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                            <Ellipse Width="9" Height="9" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource BrushTextMuted}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource BrushWarning}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding StatusText}" Margin="8,0,0,0" FontSize="12"
                                       VerticalAlignment="Center" MaxWidth="520"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource BrushTextSecondary}" />
                        </StackPanel>

                        <TextBlock Grid.Column="3" FontSize="12.5"
                                   FontFamily="{StaticResource FontMono}"
                                   Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"
                                   ToolTip="当前预览已持续的时间">
                            <Run Text="{Binding SnapshotCount, Mode=OneWay}" />
                            <Run Text=" 张 · " />
                            <Run Text="{Binding ElapsedText, Mode=OneWay}" />
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
