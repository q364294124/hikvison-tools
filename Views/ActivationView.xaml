<UserControl x:Class="HikDeployTool.Views.ActivationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:HikDeployTool.Views">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== 口令设置 ==================== -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="激活口令" Style="{StaticResource TextSection}" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource TextHint}" VerticalAlignment="Center" Margin="10,0,0,0"
                               Text="现场建议所有新设备用同一个初始口令，交付后由甲方在平台侧统一改。" />
                </StackPanel>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="初始口令" Style="{StaticResource TextLabel}" />
                        <Grid Width="250">
                            <PasswordBox x:Name="PwdBox"
                                         Visibility="{Binding ShowPassword, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                                         views:PasswordBoxHelper.Attach="True"
                                         views:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox x:Name="PwdPlain"
                                     Visibility="{Binding ShowPassword, Converter={StaticResource BoolToVisibility}}"
                                     Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{StaticResource FontMono}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="再次输入以核对" Style="{StaticResource TextLabel}" />
                        <Grid Width="250">
                            <PasswordBox x:Name="PwdConfirm"
                                         Visibility="{Binding ShowPassword, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                                         views:PasswordBoxHelper.Attach="True"
                                         views:PasswordBoxHelper.BoundPassword="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox x:Name="PwdConfirmPlain"
                                     Visibility="{Binding ShowPassword, Converter={StaticResource BoolToVisibility}}"
                                     Text="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{StaticResource FontMono}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,8,0">
                        <Button Command="{Binding ToggleShowPasswordCommand}" MinWidth="76"
                                ToolTip="切换明文 / 密文显示">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                    <Setter Property="Content" Value="显示明文" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowPassword}" Value="True">
                                            <Setter Property="Content" Value="隐藏口令" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Command="{Binding GeneratePasswordCommand}" Style="{StaticResource SecondaryButton}"
                                Margin="8,0,0,0" MinWidth="104" Content="生成强口令"
                                ToolTip="生成 12 位随机口令并复制到剪贴板" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                        <Button Command="{Binding ConfirmPasswordCommand}" Style="{StaticResource GhostButton}"
                                Content="核对两次输入" MinHeight="34" />
                    </StackPanel>

                    <StackPanel Grid.Column="4" Margin="18,0,0,0" VerticalAlignment="Bottom">
                        <ProgressBar Value="{Binding StrengthPercent, Mode=OneWay}" Maximum="100" Margin="0,0,0,6"
                                     Foreground="{StaticResource BrushAccent}" />
                        <TextBlock Text="{Binding StrengthText}" Style="{StaticResource TextHint}" />
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource Divider}" Margin="0,12,0,10" />

                <StackPanel Orientation="Horizontal">
                    <CheckBox Content="允许弱口令（老固件不接受特殊字符时勾选）" IsChecked="{Binding AllowWeakPassword}" />
                    <TextBlock Style="{StaticResource TextHint}" VerticalAlignment="Center" Margin="16,0,0,0"
                               Text="{Binding PasswordMatchText}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ==================== 清单工具条 ==================== -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Command="{Binding LoadTargetsCommand}" Style="{StaticResource SoftButton}"
                            Content="载入选中设备" ToolTip="把「设备发现」页勾选的设备载入清单" />
                    <Button Command="{Binding UseNotActivatedCommand}" Style="{StaticResource GhostButton}"
                            Content="载入全部未激活" />
                    <Button Command="{Binding UseAllDevicesCommand}" Style="{StaticResource GhostButton}"
                            Content="载入全部设备" />
                    <Button Command="{Binding ClearTargetsCommand}" Style="{StaticResource GhostButton}"
                            Content="清空清单" />
                </StackPanel>

                <TextBlock Grid.Column="1" Style="{StaticResource TextHint}" VerticalAlignment="Center"
                           Margin="16,0" TextTrimming="CharacterEllipsis" Text="{Binding TargetSummary}" />
            </Grid>
        </Border>

        <!-- ==================== 清单与结果 ==================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardTight}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource BrushSurfaceAlt}"
                            BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="12,9">
                        <Grid>
                            <TextBlock Text="待处理清单" Style="{StaticResource TextSection}" />
                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource TextHint}"
                                       Text="{Binding TargetCount, StringFormat=共 {0} 台}" />
                        </Grid>
                    </Border>

                    <Grid>
                        <ListBox ItemsSource="{Binding Targets}" BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Background="Transparent" Padding="12,7"
                                                        BorderBrush="{StaticResource BrushDivider}" BorderThickness="0,0,0,1">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushSurfaceAlt}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding ModelText}" FontSize="12.5" />
                                            <TextBlock FontSize="11" Margin="0,3,0,0"
                                                       Foreground="{StaticResource BrushTextMuted}">
                                                <Run Text="{Binding IpMaskText, Mode=OneWay}" />
                                                <Run Text="  ·  " />
                                                <Run Text="{Binding SerialNo, Mode=OneWay}" />
                                                <Run Text="  ·  " />
                                                <Run Text="{Binding ActivateText, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="24" Height="24"
                                                Command="{Binding DataContext.RemoveTargetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" ToolTip="从清单移除">
                                            <Path Style="{StaticResource IconPathSm}" Data="{StaticResource IconTrash}"
                                                  Stroke="{StaticResource BrushTextMuted}" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Style="{StaticResource TextHint}" Margin="16" TextWrapping="Wrap"
                                   VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"
                                   MaxWidth="280"
                                   Visibility="{Binding Targets.Count, Converter={StaticResource EmptyToVisibility}}"
                                   Text="清单为空。先到「设备发现」页勾选设备并投递过来，或用上面的「载入」按钮。" />
                    </Grid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardTight}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource BrushSurfaceAlt}"
                            BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="12,9">
                        <Grid>
                            <TextBlock Text="执行结果" Style="{StaticResource TextSection}" />
                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource TextHint}"
                                       Text="{Binding ResultSummary}" />
                        </Grid>
                    </Border>
                    <DataGrid ItemsSource="{Binding Results}" IsReadOnly="True" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="目标" Binding="{Binding Target}" Width="150" />
                            <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="140" />
                            <DataGridTemplateColumn Header="结论" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Success}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource BrushSuccess}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="说明" Binding="{Binding Message}" Width="*" />
                            <DataGridTextColumn Header="耗时" Binding="{Binding ElapsedMs, StringFormat={}{0} ms}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ==================== 执行条 ==================== -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" />
                    <TextBlock Style="{StaticResource TextHint}" Margin="0,7,0,0">
                        <Run Text="{Binding ProgressText, Mode=OneWay}" />
                        <Run Text="  ·  " />
                        <Run Text="{Binding ResultSummary, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}"
                            Content="取消" Margin="0,0,8,0"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                    <Button Command="{Binding ExportResultsCommand}" Style="{StaticResource SecondaryButton}"
                            Content="导出结果" Margin="0,0,8,0" />
                    <Button Command="{Binding RunCommand}" Style="{StaticResource PrimaryButton}"
                            MinWidth="128" Content="{Binding RunButtonText}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
